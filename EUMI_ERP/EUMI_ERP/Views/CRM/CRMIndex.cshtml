<script>
    $(function () {
        // ENQUIRY DATE - today and past only (no future)
        $('#enqDate').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            autoApply: true,
            maxDate: moment(),
            drops: 'down',
            opens: 'left',
            locale: { format: 'DD/MM/YYYY' }
        });

        // FOLLOW-UP DATE - today and future only (no past)
        $('#enqFollowupDate').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            autoApply: true,
            minDate: moment(),
            drops: 'down',
            opens: 'left',
            locale: { format: 'DD/MM/YYYY' }
        });

        // LOG CALL NEXT FOLLOW-UP - today and future only
        $('#logNextFollowup').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            autoApply: true,
            minDate: moment(),
            drops: 'down',
            opens: 'right',
            locale: { format: 'DD/MM/YYYY' }
        });

        // APPOINTMENT DATE - today and future only
        $('#logAppointmentDate').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            autoApply: true,
            minDate: moment(),
            drops: 'down',
            opens: 'right',
            locale: { format: 'DD/MM/YYYY' }
        });

        // SEARCH FROM DATE
        $('#srchFromDate').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            autoApply: true,
            drops: 'down',
            opens: 'center',
            locale: { format: 'DD/MM/YYYY' }
        });

        // SEARCH TO DATE
        $('#srchToDate').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            autoApply: true,
            drops: 'down',
            opens: 'center',
            locale: { format: 'DD/MM/YYYY' }
        });
        // Follow-up panel date picker
        $('#followupDatePicker').daterangepicker({
            singleDatePicker: true,
            showDropdowns: true,
            autoApply: true,
            drops: 'down',
            opens: 'left',
            locale: { format: 'DD/MM/YYYY' }
        });

        $('#followupDatePicker').on('apply.daterangepicker', function (ev, picker) {
            var dateStr = picker.startDate.format('DD/MM/YYYY');
            $('#followupDatePicker').val(dateStr);
            SetQuickBtn('');
            LoadFollowupsByDate(dateStr);
        });

        // ===== AUTO TAB FROM URL QUERY STRING =====
        function getQueryParam(name) {
            var reg = new RegExp('[?&]' + name + '=([^&#]*)');
            var result = reg.exec(window.location.search);
            return result ? decodeURIComponent(result[1]) : null;
        }

        var tab = getQueryParam('tab');

        if (tab === 'enquiries') {
            ShowTab('enquiries', document.getElementById('tabEnquiries'));
        } else if (tab === 'followup') {
            ShowTab('followup', document.getElementById('tabFollowup'));
        } else if (tab === 'assignment') {
            ShowTab('assignment', document.getElementById('tabAssignment'));
        } else {
            // Default: dashboard
            LoadDashboard();
            LoadEnquiries();
            LoadFollowupBoard();
        }
    });
</script>