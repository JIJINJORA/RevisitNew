@{
    ViewBag.Title = "CRM";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    * {
        box-sizing: border-box;
    }

    .crm-wrap {
        background: #fff;
        font-family: sans-serif;
    }

    /* ===== TOP BAR ===== */
    .crm-topbar {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 10px 20px;
        border-bottom: 1px solid #e5e7eb;
        background: #fff;
    }

    .crm-brand-title {
        font-size: 13px;
        font-weight: 700;
        color: #185FA5;
    }

    .crm-brand-sub {
        font-size: 11px;
        color: #6b7280;
    }

    .badge-leads {
        background: #e6f1fb;
        color: #185FA5;
        font-size: 12px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
    }

    .badge-hot {
        background: #faeeda;
        color: #854F0B;
        font-size: 12px;
        font-weight: 600;
        padding: 3px 10px;
        border-radius: 20px;
    }

    /* ===== TABS ===== */
    .crm-tabs {
        display: flex;
        gap: 4px;
    }

    .crm-tab {
        padding: 7px 16px;
        font-size: 13px;
        border-radius: 6px;
        cursor: pointer;
        border: 1px solid transparent;
        color: #6b7280;
        background: none;
        display: flex;
        align-items: center;
        gap: 6px;
        transition: all 0.2s;
    }

        .crm-tab.active {
            background: #e6f1fb;
            color: #185FA5;
            border-color: #b5d4f4;
            font-weight: 600;
        }

        .crm-tab:hover:not(.active) {
            background: #f3f4f6;
        }

    /* ===== BODY ===== */
    .crm-body {
        padding: 20px;
        background: #f9fafb;
        min-height: 600px;
    }

    .page {
        display: none;
    }

        .page.active {
            display: block;
        }

    /* ===== DASHBOARD ===== */
    .stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 20px;
    }

    .stat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 18px;
    }

    .stat-icon {
        width: 38px;
        height: 38px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        margin-bottom: 12px;
    }

        .stat-icon.blue {
            background: #e6f1fb;
            color: #185FA5;
        }

        .stat-icon.purple {
            background: #EEEDFE;
            color: #534AB7;
        }

        .stat-icon.amber {
            background: #faeeda;
            color: #854F0B;
        }

        .stat-icon.red {
            background: #fcebeb;
            color: #A32D2D;
        }

    .stat-num {
        font-size: 28px;
        font-weight: 700;
        color: #111827;
    }

    .stat-label {
        font-size: 13px;
        color: #6b7280;
        margin-top: 2px;
    }

    .stat-growth {
        float: right;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 20px;
        background: #eaf3de;
        color: #3B6D11;
        font-weight: 600;
    }

    .chart-row {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 14px;
    }

    .chart-box {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 18px;
    }

    .chart-title {
        font-size: 13px;
        font-weight: 600;
        color: #374151;
        margin-bottom: 14px;
        display: flex;
        align-items: center;
        gap: 6px;
    }

    /* ===== ENQUIRIES ===== */
    .enq-layout {
        display: grid;
        grid-template-columns: 2fr 1fr;
        gap: 16px;
    }

    .date-label {
        font-size: 12px;
        font-weight: 600;
        color: #6b7280;
        display: flex;
        align-items: center;
        gap: 6px;
        margin-bottom: 8px;
        margin-top: 14px;
    }

    .lead-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 10px;
    }

    .lead-avatar {
        width: 36px;
        height: 36px;
        border-radius: 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .lead-name {
        font-size: 14px;
        font-weight: 600;
        color: #111827;
    }

    .src-badge {
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 4px;
    }

    .src-direct {
        background: #e6f1fb;
        color: #185FA5;
    }

    .src-instagram {
        background: #FBEAF0;
        color: #993556;
    }

    .src-facebook {
        background: #EEEDFE;
        color: #534AB7;
    }

    .src-google {
        background: #eaf3de;
        color: #3B6D11;
    }

    .lead-contact {
        display: flex;
        gap: 16px;
        font-size: 12px;
        color: #6b7280;
        margin: 8px 0;
        align-items: center;
        flex-wrap: wrap;
    }

    .lead-note {
        font-size: 12px;
        color: #6b7280;
        font-style: italic;
        border-left: 3px solid #e5e7eb;
        padding-left: 8px;
        margin-top: 6px;
    }

    .followup-badge {
        display: flex;
        align-items: center;
        gap: 4px;
        font-size: 12px;
        font-weight: 600;
        color: #D97706;
    }

    .followup-date {
        font-size: 11px;
        color: #6b7280;
        margin-top: 2px;
    }

    .today-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 16px;
        height: fit-content;
    }

    .today-title {
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .pending-badge {
        background: #faeeda;
        color: #854F0B;
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 20px;
        font-weight: 600;
    }

    .all-done-box {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        padding: 30px 0;
        color: #9ca3af;
        font-size: 13px;
        gap: 6px;
        text-align: center;
    }

    /* ===== BUTTONS ===== */
    .btn-primary-crm {
        background: #185FA5;
        color: #fff;
        border: none;
        border-radius: 7px;
        padding: 8px 16px;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 600;
    }

        .btn-primary-crm:hover {
            background: #14518A;
        }

    .btn-outline-crm {
        background: none;
        border: 1px solid #d1d5db;
        border-radius: 7px;
        padding: 8px 16px;
        font-size: 13px;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: #374151;
    }

        .btn-outline-crm:hover {
            background: #f3f4f6;
        }

    /* ===== FOLLOW-UP ===== */
    .fu-stat-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-bottom: 18px;
    }

    .fu-stat-card {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px 16px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .fu-stat-label {
        font-size: 11px;
        font-weight: 700;
        color: #6b7280;
    }

    .fu-stat-num {
        font-size: 26px;
        font-weight: 700;
        color: #111827;
        margin-top: 4px;
    }

    .fu-layout {
        display: grid;
        grid-template-columns: 1fr 1.8fr;
        gap: 14px;
    }

    .patient-dir {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 14px;
    }

    .patient-dir-title {
        font-size: 12px;
        font-weight: 700;
        color: #6b7280;
        margin-bottom: 12px;
    }

    .patient-item {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px;
        margin-bottom: 8px;
        cursor: pointer;
        transition: border-color 0.2s;
    }

        .patient-item:hover,
        .patient-item.selected {
            border-color: #185FA5;
            background: #f0f7ff;
        }

    .pi-name {
        font-size: 16px;
        font-weight: 700;
        color: #111827;
    }

    .pi-sub {
        font-size: 11px;
        color: #6b7280;
        margin-top: 2px;
    }

    .rank-hot {
        background: #faece7;
        color: #993C1D;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .rank-warm {
        background: #faeeda;
        color: #854F0B;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .rank-cold {
        background: #e6f1fb;
        color: #185FA5;
        font-size: 10px;
        font-weight: 700;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .overdue-tag {
        background: #fcebeb;
        color: #A32D2D;
        font-size: 10px;
        font-weight: 600;
        padding: 2px 8px;
        border-radius: 20px;
    }

    .detail-panel {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 18px;
    }

    .dp-name {
        font-size: 20px;
        font-weight: 700;
        color: #111827;
    }

    .dp-contact-pill {
        border: 1px solid #d1d5db;
        border-radius: 20px;
        padding: 8px 18px;
        font-size: 16px;
        color: #374151;
        display: inline-flex;
        align-items: center;
        gap: 7px;
    }

    .temp-bar {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        border-radius: 8px;
        overflow: hidden;
        border: 1px solid #e5e7eb;
        margin-top: 8px;
    }

    .temp-cell {
        padding: 10px;
        text-align: center;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        border-right: 1px solid #e5e7eb;
        background: #f9fafb;
        color: #6b7280;
        transition: all 0.2s;
    }

        .temp-cell:last-child {
            border-right: none;
        }

        .temp-cell.hot-active {
            background: #D85A30;
            color: #fff;
        }

        .temp-cell.warm-active {
            background: #EF9F27;
            color: #fff;
        }

        .temp-cell.cold-active {
            background: #185FA5;
            color: #fff;
        }

        .temp-cell.drop-active {
            background: #6b7280;
            color: #fff;
        }

    .filter-rank-row {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .rank-filter-btn {
        padding: 5px 14px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        border: 1px solid #d1d5db;
        background: none;
        color: #374151;
        transition: all 0.2s;
    }

        .rank-filter-btn.active {
            background: #111827;
            color: #fff;
            border-color: #111827;
        }

    .search-input {
        border: 1px solid #d1d5db;
        border-radius: 7px;
        padding: 7px 12px 7px 32px;
        font-size: 13px;
        color: #374151;
        background: #fff;
        outline: none;
        width: 200px;
    }

    .search-wrap {
        position: relative;
        display: inline-block;
    }

        .search-wrap i {
            position: absolute;
            left: 9px;
            top: 50%;
            transform: translateY(-50%);
            color: #9ca3af;
            font-size: 15px;
        }

    .page-heading {
        font-size: 24px;
        font-weight: 700;
        color: #111827;
        margin-bottom: 4px;
    }

    .page-sub {
        font-size: 12px;
        color: #6b7280;
        margin-bottom: 18px;
    }

    .call-log-area {
        border: 1px solid #e5e7eb;
        border-radius: 8px;
        padding: 12px;
        margin-top: 14px;
        background: #f9fafb;
    }

    .call-log-item {
        display: flex;
        justify-content: space-between;
        font-size: 12px;
        padding: 6px 0;
        border-bottom: 1px solid #e5e7eb;
        color: #374151;
    }

    .chart-box {
        background: #fff;
        border: 1px solid #e5e7eb;
        border-radius: 10px;
        padding: 18px;
        display: flex;
        flex-direction: column;
    }

    .call-log-item:last-child {
        border-bottom: none;
    }

    #detailPanel {
        scroll-margin-top: 100px; /* adjust to match your navbar's height */
    }

    #btnApptFixed.active {
        background: #1D9E75 !important;
        border-color: #1D9E75 !important;
        color: #fff !important;
    }
</style>



<div class="crm-wrap">

    <!-- TOP BAR -->
    <div class="crm-topbar">
        <div style="display:flex;align-items:center;gap:16px;">
            <div>
                <div class="crm-brand-title">CRM OPERATIONS</div>
                <div class="crm-brand-sub">HMS CRM</div>
            </div>
            <div style="display:flex;gap:8px;align-items:center;">
                <span class="badge-leads" id="lblTotalLeads">0 LEADS</span>
                <span class="badge-hot" id="lblHotLeads">0 HOT 🔥</span>
            </div>
        </div>
        <div style="display:flex;align-items:center;gap:12px;">
            <div class="search-wrap">
                <i class="ft-search"></i>
                <input type="text" class="search-input" id="globalSearch" placeholder="Search leads..." onkeyup="GlobalSearch()" />
            </div>
            <div class="crm-tabs" style="display:none;">
                <button class="crm-tab active" onclick="ShowTab('dashboard', this)" id="tabDashboard">
                    <i class="ft-grid"></i> Dashboard
                </button>
                <button class="crm-tab" onclick="ShowTab('enquiries', this)" id="tabEnquiries">
                    <i class="ft-user"></i> Patient Enquiries
                </button>
                <button class="crm-tab" onclick="ShowTab('followup', this)" id="tabFollowup">
                    <i class="ft-phone-call"></i> CRM Follow-up
                    <button class="crm-tab" onclick="ShowTab('assignment', this)" id="tabAssignment">
                        <i class="ft-user-check"></i> Lead Assignment
                    </button>
            </div>
        </div>
    </div>

    <div class="crm-body">

        <!-- ==================== DASHBOARD ==================== -->
        <div id="tab-dashboard" class="page active">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:18px;">
                <div>
                    <div class="page-heading">Overview</div>
                    <div class="page-sub">MEDOC HMS CRM SYSTEM DASHBOARD</div>
                </div>
                <button class="btn-primary-crm" onclick="OpenAddEnquiry()">
                    <i class="ft-plus"></i> Add New Enquiry
                </button>
            </div>

            <!-- Stat Cards -->
            <div class="stat-grid">
                <div class="stat-card" onclick="GoToPatientEnquiries()" style="cursor:pointer;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div class="stat-icon blue"><i class="ft-users"></i></div>
                        <span class="stat-growth" id="dbGrowthEnq">+0%</span>
                    </div>
                    <div class="stat-num" id="dbTotalEnq">0</div>
                    <div class="stat-label">Total Enquiries</div>
                </div>
                <div class="stat-card">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div class="stat-icon purple"><i class="ft-calendar"></i></div>
                        <span class="stat-growth" id="dbGrowthApp">+0%</span>
                    </div>
                    <div class="stat-num" id="dbTotalApp">0</div>
                    <div class="stat-label">Appointments Fixed</div>
                </div>

                <div class="stat-card" onclick="GoToFollowupsToday()" style="cursor:pointer;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div class="stat-icon amber"><i class="ft-clock"></i></div>
                    </div>
                    <div class="stat-num" id="dbFollowupToday">0</div>
                    <div class="stat-label">Follow-ups Today</div>
                </div>
                <div class="stat-card" onclick="GoToOverdueFollowups()" style="cursor:pointer;">
                    <div style="display:flex;justify-content:space-between;align-items:flex-start;">
                        <div class="stat-icon red"><i class="ft-alert-triangle"></i></div>
                    </div>
                    <div class="stat-num" id="dbMissedFollowup">0</div>
                    <div class="stat-label">Missed Follow-ups</div>
                </div>
            </div>

            <!-- Charts -->
            <div class="chart-row">
                <div class="chart-box">
                    <div class="chart-title">
                        <i class="ft-trending-up"></i> Enquiry vs Appointment Conversion
                    </div>
                    <div style="position:relative; height:220px;">
                        <canvas id="chartEnqApp"></canvas>
                    </div>
                    <div style="display:flex;gap:20px;margin-top:12px;">
                        <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#6b7280;">
                            <div style="width:12px;height:12px;border-radius:3px;background:#378ADD;"></div>
                            Enquiries
                        </div>
                        <div style="display:flex;align-items:center;gap:6px;font-size:12px;color:#6b7280;">
                            <div style="width:12px;height:12px;border-radius:3px;background:#1D9E75;"></div>
                            Appointments
                        </div>
                    </div>
                </div>
                <div class="chart-box">
                    <div class="chart-title">
                        <i class="ft-pie-chart"></i> Leads by Source
                    </div>
                    <div style="position:relative; height:220px;">
                        <canvas id="chartSource"></canvas>
                    </div>
                    <div id="sourceLegend" style="margin-top:4px;"></div>
                </div>
            </div>
        </div>
        <!-- ✅ tab-dashboard CLOSED HERE -->
        <!-- ==================== PATIENT ENQUIRIES ==================== -->
        <div id="tab-enquiries" class="page">
            <div style="display:flex;justify-content:space-between;align-items:flex-start;margin-bottom:16px;">
                <div>
                    <div class="page-heading">Patient Inquiries</div>
                    <div style="font-size:13px;font-weight:700;color:#111827;margin-top:6px;">
                        Active Patient Enquiries
                        <span style="background:#e6f1fb;color:#185FA5;font-size:11px;font-weight:700;padding:2px 10px;border-radius:20px;margin-left:8px;" id="enqTotalBadge">0 Total</span>
                    </div>
                    <div style="font-size:12px;color:#6b7280;margin-top:3px;">Manage leads from Google Ads, social media, and direct calls.</div>
                </div>
                <div style="display:flex;gap:8px;align-items:center;margin-top:8px;">
                    <button class="btn-outline-crm" onclick="OpenImportExcel()">
                        <i class="ft-upload"></i> Import from Excel
                    </button>
                    <button class="btn-outline-crm" onclick="OpenEnqSearch()">
                        <i class="ft-search"></i> Search
                    </button>
                    <button class="btn-primary-crm" onclick="OpenAddEnquiry()">
                        <i class="ft-plus"></i> Add New Enquiry
                    </button>
                </div>
            </div>

            <div class="enq-layout">
                <!-- Left: Enquiry List -->
                <div>
                    <!-- FILTER BAR -->
                    <div id="filterBar" style="display:none;background:#fff;border:1px solid #e5e7eb;
                         border-radius:10px;padding:16px 20px;margin-bottom:14px;">
                        <div style="display:grid;grid-template-columns:2fr 1.5fr 1.5fr 1.5fr auto;gap:14px;align-items:end;">
                            <div>
                                <label style="font-size:11px;font-weight:700;color:#6b7280;letter-spacing:0.5px;display:block;margin-bottom:6px;">SEARCH DETAILS</label>
                                <div style="position:relative;">
                                    <i class="ft-search" style="position:absolute;left:10px;top:50%;transform:translateY(-50%);color:#9ca3af;font-size:13px;"></i>
                                    <input type="text" id="filterSearch" onkeyup="ApplyFilters()" placeholder="Name, phone, info..."
                                           style="width:100%;padding:8px 10px 8px 32px;border:1px solid #e5e7eb;border-radius:7px;font-size:13px;color:#374151;outline:none;" />
                                </div>
                            </div>
                            <div>
                                <label style="font-size:11px;font-weight:700;color:#6b7280;letter-spacing:0.5px;display:block;margin-bottom:6px;">LEAD SOURCE</label>
                                <select id="filterSource" onchange="ApplyFilters()"
                                        style="width:100%;padding:8px 10px;border:1px solid #e5e7eb;border-radius:7px;font-size:13px;color:#374151;outline:none;background:#fff;">
                                    <option value="">All Sources</option>
                                    <option value="Google">Google Ads</option>
                                    <option value="Facebook">Facebook</option>
                                    <option value="Instagram">Instagram</option>
                                    <option value="Direct">Direct</option>
                                    <option value="Referral">Referral</option>
                                </select>
                            </div>
                            <div>
                                <label style="font-size:11px;font-weight:700;color:#6b7280;letter-spacing:0.5px;display:block;margin-bottom:6px;">INQUIRY STATUS</label>
                                <select id="filterStage" onchange="ApplyFilters()"
                                        style="width:100%;padding:8px 10px;border:1px solid #e5e7eb;border-radius:7px;font-size:13px;color:#374151;outline:none;background:#fff;">
                                    <option value="">All Statuses</option>
                                    <option value="New Lead">New Lead</option>
                                    <option value="Contacted">Contacted</option>
                                    <option value="Appointment Fixed">Appointment Fixed</option>
                                    <option value="Converted">Converted</option>
                                    <option value="Lost">Lost</option>
                                </select>
                            </div>
                            <div>
                                <label style="font-size:11px;font-weight:700;color:#6b7280;letter-spacing:0.5px;display:block;margin-bottom:6px;">FOLLOW-UP DATE</label>
                                <select id="filterFollowup" onchange="ApplyFilters()"
