function loadTemplateForProcedure(procedureId) {
    $.ajax({
        url: '@Url.Action("GetTemplateByProcedure", "SessionForm")',
        type: 'POST',
        data: { procedureId: procedureId },
        success: function (data) {
            $('#dayRows').empty();

            // Get base date from BillDate (dd/MM/yyyy)
            var baseDateStr = $('#BillDate').val();
            var baseDate = parseDate(baseDateStr);
            if (!baseDate || isNaN(baseDate)) {
                baseDate = new Date();
            }

            if (data && data.success === false) {
                currentTreatmentId = 0;
                var todayStr = formatDate(baseDate);
                addDayRow(0, todayStr, '', '', '', '', 1);
                return;
            }

            if (data && data.error) {
                warningshow('Error: ' + data.message);
                return;
            }

            if (data && data.type === 2 && data.days) {
                currentTreatmentId = data.treatmentId || 0;
                var previousDate = new Date(baseDate);
                var order = 1;

                $.each(data.days, function (i, day) {
                    var sessionNum = day.dayOfWeek;
                    var sessionDateObj;

                    if (i === 0) {
                        sessionDateObj = new Date(previousDate);
                    } else {
                        sessionDateObj = new Date(previousDate);
                        sessionDateObj.setDate(sessionDateObj.getDate() + sessionNum);
                    }

                    var dateStr = formatDate(sessionDateObj);
                    addDayRow(
                        0,
                        dateStr,
                        day.duration || '',
                        '',
                        '',
                        day.notes || '',
                        order++
                    );

                    previousDate = sessionDateObj;
                });
            } else if (data && data.type === 1) {
                currentTreatmentId = data.treatmentId || 0;
                var totalSessions = data.sessions || 0;
                var defaultDuration = data.duration || '';

                var previousDate = new Date(baseDate);
                var order = 1;

                for (var sessionNum = 1; sessionNum <= totalSessions; sessionNum++) {
                    var sessionDateObj;
                    if (sessionNum === 1) {
                        sessionDateObj = new Date(previousDate);
                    } else {
                        sessionDateObj = new Date(previousDate);
                        sessionDateObj.setDate(sessionDateObj.getDate() + sessionNum);
                    }

                    var dateStr = formatDate(sessionDateObj);
                    addDayRow(
                        0,
                        dateStr,
                        defaultDuration,
                        '',
                        '',
                        '',
                        order++
                    );

                    previousDate = sessionDateObj;
                }
            } else {
                currentTreatmentId = 0;
                var todayStr = formatDate(baseDate);
                addDayRow(0, todayStr, '', '', '', '', 1);
            }
        },
        error: function () {
            warningshow('Error loading template. Check console for details.');
        }
    });
}

// Helper to format Date object as yyyy-MM-dd
function formatDate(date) {
    var year = date.getFullYear();
    var month = String(date.getMonth() + 1).padStart(2, '0');
    var day = String(date.getDate()).padStart(2, '0');
    return year + '-' + month + '-' + day;
}
        function addDayRow(dayId, sessionDate, duration, room, therapist, notes, order) {
            if (!sessionDate) {
                var today = new Date();
                var y = today.getFullYear();
                var m = String(today.getMonth() + 1).padStart(2, '0');
                var d = String(today.getDate()).padStart(2, '0');
                sessionDate = y + '-' + m + '-' + d;
            }

            var row = '<tr class="day-row">' +
                '<td class="jsgrid-cell" style="text-align:center; padding:0;">' +
                '<button type="button" class="delete-row" style="background:none; border:none; color:#dc3545; font-size:1.2rem; width:100%; height:100%;">' +
                '<i class="fa fa-trash"></i>' +
                '</button>' +
                '</td>' +
                '<td class="jsgrid-cell slno" style="text-align:center;">' + order + '</td>' +
                '<td class="jsgrid-cell" style="padding:0;">' +
                '<input type="hidden" class="day-id" value="' + dayId + '">' +
                '<input type="text" class="form-control session-date datepicker" style="width:100%; height:100%; border:none; background:transparent; padding:8px 10px;" value="' + sessionDate + '">' +
                '</td>' +
                '<td class="jsgrid-cell" style="padding:0;">' +
                '<input type="number" class="form-control day-duration" placeholder="Hours" step="0.5" min="0" style="width:100%; height:100%; border:none; background:transparent; padding:8px 10px;" value="' + (duration || '') + '">' +
                '</td>' +
                '<td class="jsgrid-cell" style="padding:0;">' +
                '<input type="number" class="form-control day-room" placeholder="Room" style="width:100%; height:100%; border:none; background:transparent; padding:8px 10px;" value="' + (room || '') + '">' +
                '</td>' +
                '<td class="jsgrid-cell" style="padding:0;">' +
                '<input type="text" class="form-control day-therapist" placeholder="Therapist/Consultant" style="width:100%; height:100%; border:none; background:transparent; padding:8px 10px;" value="' + (therapist || '') + '">' +
                '</td>' +
                '<td class="jsgrid-cell" style="padding:0;">' +
                '<input type="text" class="form-control day-notes" placeholder="Notes" style="width:100%; height:100%; border:none; background:transparent; padding:8px 10px;" value="' + (notes || '') + '">' +
                '</td>' +
                '</tr>';

            $('#dayRows').append(row);

            // Initialize jQuery UI datepicker on the newly added date input
            $('#dayRows .datepicker').last().datepicker({
