    function saveSessionTreatment() {
    console.log('===== SAVE SESSION TREATMENT =====');

    var procedureId = $('#selectedProcedureId').val();
    console.log('Procedure ID:', procedureId);

    if (!procedureId) {
        showProcedureWarning();
        return;
    }

    // Build age/sex string from Age and Gender
    var age = $('#Age').val();
    var gender = $('#Gender option:selected').text();
    var ageSex = age + (gender !== 'Select' ? '/' + gender : '');

    console.log('Age/Sex:', ageSex);

    // DEBUG: Check what rows exist
    console.log('Checking for rows...');
    console.log('#dayRows element:', $('#dayRows').length);
    console.log('.day-row count:', $('#dayRows .day-row').length);
    console.log('All rows HTML:', $('#dayRows').html());

    // Try alternative selectors
    console.log('Alternative selector tr count:', $('#dayRows tr').length);
    console.log('Rows with class day-row:', $('.day-row').length);

    var formData = {
        FormDate: formatDateForSave($('#BillDate').val()),
        RegNo: $('#RegNo').val(),
        PatientName: $('#Name').val(),
        AgeSex: ageSex,
        DoctorName: $('#Doctor option:selected').text(),
        Contact: $('#contnum').val(),
        OPIPNumber: $('#OpNo').val() || $('#IpNo').val(),
        ProcedureName: $('#procedureSearch').val(),
        ProcedureId: procedureId,
        Details: []
    };

    console.log('Form Data Header:', {
        FormDate: formData.FormDate,
        RegNo: formData.RegNo,
        PatientName: formData.PatientName,
        ProcedureName: formData.ProcedureName
    });

    var order = 1;
    var valid = true;

    // Try multiple selectors to find the rows
    var rows = $('#dayRows .day-row');
    if (rows.length === 0) {
        rows = $('#dayRows tr');
    }
    if (rows.length === 0) {
        rows = $('#daysBodyTable tbody tr');
    }

    console.log('Rows found:', rows.length);

    rows.each(function () {
        console.log('Processing row:', this);

        // Try different ways to find the input values
        var sessionDate = $(this).find('.session-date').val();
        var hours = $(this).find('.day-duration').val();
        var room = $(this).find('.day-room').val();
        var therapist = $(this).find('.day-therapist').val();
        var notes = $(this).find('.day-notes').val();

        // If not found with class, try by input type or position
        if (!sessionDate) {
            sessionDate = $(this).find('input[type="text"]:eq(0)').val();
        }
        if (!hours) {
            hours = $(this).find('input[type="number"]').val();
        }

        console.log(`Row ${order}:`, { sessionDate, hours, room, therapist, notes });

        if (!sessionDate || !hours) {
            console.log('Missing required fields:', { sessionDate, hours });
            valid = false;
            return false;
        }

        formData.Details.push({
            SLNo: order++,
            SessionDate: sessionDate,
            Hours: hours,
            Room: room || '',
            TherapistConsultant: therapist || '',
            Notes: notes || ''
        });
    });

    if (!valid) {
        warningshow('Please fill all date and hours fields.');
        return;
    }

    if (formData.Details.length === 0) {
        console.log('No details collected!');
        warningshow('No session rows found. Please add at least one session day.');
        return;
    }

    console.log('Sending Data:', JSON.stringify(formData, null, 2));

    $('#saveStatus').text('Saving...');

    $.ajax({
        url: '@Url.Action("SavePatientSession", "SessionForm")',
        type: 'POST',
        contentType: 'application/json',
        data: JSON.stringify(formData),
        success: function (res) {
            console.log('Save response:', res);
            $('#saveStatus').text('');
            if (res.success) {
                $('#successModal').fadeIn();
            } else {
                warningshow(res.message || 'Save failed.');
            }
        },
        error: function (xhr, status, error) {
            console.error('Save error:', status, error);
            console.error('Response:', xhr.responseText);
            $('#saveStatus').text('Error: ' + error);
            warningshow('Error saving: ' + error);
        }
    });
}
        function warningshow(message, Id) {
            $('#popupmessage').text(message);
            $('#Warningpopup').show();
            if (Id) { $('#' + Id).focus().select(); }
            window.setTimeout(function () {
                $('#Warningpopup').hide();
            }, 3000);
        }
    

    // Numeric validation
    function isNumberKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode > 31 && (charCode < 48 || charCode > 57)) {
            evt.preventDefault();
            return false;
        }
        return true;
    }

    // Character validation
    function isCharacterKey(evt) {
        var charCode = (evt.which) ? evt.which : evt.keyCode;
        if (charCode < 48) return true;
        if (charCode >= 65 && charCode <= 90) return true;
        if (charCode >= 97 && charCode <= 122) return true;
        evt.preventDefault();
        return false;
    }

