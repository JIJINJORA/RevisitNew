@{
    ViewBag.Title = "SessionForm";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<script type="text/javascript" src="~/ProjectScript/Windowsprint.js"></script>
<script type="text/javascript" src="~/ProjectScript/CommonHMS.js"></script>
<script src="~/Scripts/Autocomplete/jquery-ui.js"></script>

<style>
    .label-control {
        font-weight: bold;
    }

    .p-1 {
        padding-top: .1rem !important;
        padding-bottom: .1rem !important;
    }

    select.form-control:not([size]):not([multiple]) {
        height: calc(2.25rem + 4px);
    }

    .jsgrid-table {
        width: 100%;
        table-layout: fixed;
        border-collapse: collapse;
        border-spacing: 0;
        background-color: #ffffff;
    }

    .jsgrid-header-row {
        background-color: #14989b;
        color: white;
        font-weight: 600;
    }

    .jsgrid-header-cell {
        padding: 10px;
        border-right: 1px solid #2ec4c6;
        text-align: center;
    }

    .jsgrid-header-row th:last-child {
        border-right: none;
    }

    .jsgrid-cell {
        border: 1px solid #e6e6e6;
        height: 38px;
        background-color: #ffffff;
    }

        .jsgrid-cell input {
            width: 100%;
            height: 100%;
            border: none;
            background: transparent;
            padding: 8px 10px;
            box-sizing: border-box;
            font-size: 0.95rem;
        }

            .jsgrid-cell input:focus {
                outline: none;
                background-color: #fff;
                border: 1px solid #66afe9;
                box-shadow: inset 0 1px 1px rgba(0,0,0,.075), 0 0 8px rgba(102,175,233,.6);
            }

    .delete-row {
        background: none;
        border: none;
        color: #dc3545;
        font-size: 1.2rem;
        cursor: pointer;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .delete-row:hover {
            color: #c82333;
        }

    .white-bg {
        background-color: #fff;
        padding: 15px;
        border-radius: 0 0 4px 4px;
    }

    .button-row {
        margin-top: 15px;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
    }

    .patient-bg {
        background-color: #E0F3F4;
        padding: 12px 15px;
    }

    hr {
        margin: 0;
        border-top: 2px solid #ddd;
    }

    /* Success modal */
    .custom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0,0,0,0.4);
    }

    .custom-modal-content {
        background-color: #f2f2f2;
        margin: 10% auto;
        padding: 40px 20px;
        width: 500px;
        border-radius: 10px;
        text-align: center;
    }

    .check-circle {
        width: 100px;
        height: 100px;
        border: 6px solid #cfe6cf;
        border-radius: 50%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .check-circle i {
            color: #8bc34a;
            font-size: 50px;
        }

    .custom-modal-content h2 {
        font-weight: 600;
        color: #555;
        margin-bottom: 30px;
    }

    .ok-btn {
        background-color: #7fc0df;
        color: white;
        border: none;
        padding: 10px 30px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

        .ok-btn:hover {
            background-color: #5ba9d6;
        }

    .btn-teal {
        background-color: #159a9c;
        color: white;
        border: none;
    }

        .btn-teal:hover {
            background-color: #117e80;
            color: white;
        }

    #ProcedureName0 {
        width: 100%;
        max-width: 400px;
    }

    /* Autocomplete dropdown fix */
    .ui-autocomplete {
        margin-top: 0 !important;
        padding-top: 0 !important;
    }
   

</style>





