@model EUMI_ERP.Models.SessionTreatmentModel
@{
    ViewBag.Title = "Session Based Treatments";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<!-- Add jQuery UI (if not already in layout) -->
<link rel="stylesheet" href="https://code.jquery.com/ui/1.12.1/themes/base/jquery-ui.css">
<!-- Font Awesome (if needed) -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

<style>
    .page-header-custom {
        background-color: #159a9c;
        color: white;
        padding: 15px 20px;
        font-size: 20px;
        font-weight: 600;
        border-radius: 4px 4px 0 0;
    }

    .master-container {
        background: #f4f6f9;
        padding: 20px;
        border-radius: 0 0 4px 4px;
    }

    .editor-section {
        background: #fff;
        padding: 20px;
        margin-bottom: 20px;
        border-radius: 4px;
        border: 1px solid #ddd;
    }

    .table-days th, .table-days td {
        vertical-align: middle;
    }

    .btn-teal {
        background-color: #159a9c;
        color: white;
        border: none;
    }

        .btn-teal:hover {
            background-color: #117e80;
            color: white;
        }

    /* Custom modal base (reused for success) */
    .custom-modal {
        display: none;
        position: fixed;
        z-index: 9999;
        left: 0;
        top: 0;
        width: 100%;
        height: 100%;
        background-color: rgba(0, 0, 0, 0.4);
    }

    .custom-modal-content {
        background-color: #f2f2f2;
        margin: 10% auto;
        padding: 40px 20px;
        width: 500px;
        border-radius: 10px;
        text-align: center;
        position: relative;
    }

    .check-circle {
        width: 100px;
        height: 100px;
        border: 6px solid #cfe6cf;
        border-radius: 50%;
        margin: 0 auto 20px;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .check-circle i {
            color: #8bc34a;
            font-size: 50px;
        }

    .custom-modal-content h2 {
        font-weight: 600;
        color: #555;
        margin-bottom: 30px;
    }

    .ok-btn {
        background-color: #7fc0df;
        color: white;
        border: none;
        padding: 10px 30px;
        border-radius: 8px;
        font-weight: 600;
        cursor: pointer;
    }

        .ok-btn:hover {
            background-color: #5ba9d6;
        }

    /* Warning popup */
    #Warningpopup {
        display: none;
        position: fixed;
        top: 60px;
        left: 50%;
        transform: translateX(-50%);
        background-color: #f16b7a;
        color: white;
        padding: 12px 30px;
        border-radius: 6px;
        font-size: 15px;
        font-weight: 600;
        z-index: 99999;
        text-align: center;
        min-width: 250px;
    }

    /* Search row container */
    .search-row {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .search-row input,
        .search-row .btn {
            height: 40px;
            box-sizing: border-box;
            margin: 0;
            line-height: 40px;
            white-space: nowrap;
        }

        .search-row #procedureSearch {
            flex: 1;
            min-width: 200px;
        }

        .search-row #txtsessioncount {
            width: 180px;
        }

        .search-row #btnAddProcedure {
            width: 40px;
            padding: 0;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            line-height: normal;
        }

        .search-row #btnapply {
            padding: 0 15px;
        }
</style>

<!-- Warning Popup -->
<div id="Warningpopup">
    <span id="popupmessage"></span>
</div>

<div class="page-header-custom">
    Session Treatment Editor
</div>

<div class="master-container">
    <div class="editor-section">
        <!-- Search row -->
        <div class="row">
            <div class="col-md-6">
                <h4>Search Procedure</h4>
                <div class="search-row">
                    <input type="text" id="procedureSearch" class="form-control" placeholder="Type procedure name..." />

                    <button class="btn btn-teal" type="button" id="btnAddProcedure">
                        <i class="fa fa-plus"></i>
                    </button>

                    <input type="number" id="txtsessioncount" class="form-control session-input" placeholder="No.of. Sessions" min="1" />

                    <button class="btn btn-teal" type="button" id="btnapply" onclick="fnsessiongenerate()">
                        Apply
                    </button>
                </div>
                <input type="hidden" id="selectedProcedureId" />
                <span id="selectedProcedureName" class="help-block"></span>
            </div>
            <div class="col-md-6 text-right" style="padding-top: 25px;">
                <button type="button" id="btnSaveEditor" class="btn btn-teal">Save <i class="fa fa-check-square"></i></button>
                <button type="button" id="btnClearEditor" class="btn btn-teal">Clear <i class="fa fa-refresh"></i></button>
                <span id="saveStatus" style="margin-left:10px;"></span>
            </div>
        </div>

        <!-- Days table (hidden initially) -->
        <div id="dayEditorContainer" style="display:none; margin-top: 20px;">
            <h5><label class="label-control">Session Days</label></h5>
            <table class="table table-bordered table-days" id="daysTable">
                <thead>
                    <tr>
                        <th style="width:50px">SL#</th>
                        <th>Session #(After Days)</th>
                        <th>Duration (hours)</th>
                        <th>Notes</th>
                        <th style="width:80px">Action</th>
                    </tr>
                </thead>
                <tbody id="dayRows"></tbody>
            </table>
            <button type="button" id="addDayRow" class="btn btn-sm btn-primary">Add Session</button>
        </div>
    </div>
</div>

<!-- Add Procedure Modal (Bootstrap modal) -->
<div class="modal fade" id="addProcedureModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Add New Procedure</h5>
                <button type="button" class="close" data-dismiss="modal">&times;</button>
            </div>
            <div class="modal-body">
                <div class="form-group">
                    <label>Procedure Name</label>
                    <input type="text" id="newProcedureName" class="form-control" />
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Cancel</button>
                <button type="button" id="btnSaveProcedure" class="btn btn-primary">Save</button>
            </div>
        </div>
    </div>
</div>

<!-- Success Popup Modal (custom) -->
<div id="successModal" class="custom-modal">
    <div class="custom-modal-content">
        <div class="check-circle">
            <i class="fa fa-check"></i>
        </div>
        <h2>Data Saved Successfully</h2>
        <button id="successOkBtn" class="ok-btn">OK</button>
    </div>
</div>

@section scripts {
    <script src="https://code.jquery.com/ui/1.12.1/jquery-ui.min.js"></script>
    <script>
        var currentTreatmentId = @(Model != null ? Model.TreatmentId : 0);

        $(document).ready(function () {
            $('#procedureSearch').val('');
            $('#selectedProcedureId').val('');
            $('#txtsessioncount').val('');
            $('#dayRows').empty();
            $('#dayEditorContainer').hide();
            $('#saveStatus').text('');
            currentTreatmentId = 0;

            @if (Model != null && Model.TreatmentId > 0 && Model.ProcedureId > 0)
            {
                <text>
                $("#procedureSearch").val(@Html.Raw(Json.Encode(Model.TreatmentName)));
                $("#selectedProcedureId").val(@Model.ProcedureId);
                loadTemplateForProcedure(@Model.ProcedureId);
                </text>
            }

            // Autocomplete for procedure search
            $("#procedureSearch").autocomplete({
                source: function (request, response) {
                    $.ajax({
                        url: '@Url.Action("SearchProcedures")',
                        type: 'GET',
                        data: { term: request.term },
                        success: function (data) {
                            response(data);
                        },
                        error: function () {
                            warningshow('Error fetching procedures.');
                        }
                    });
                },
                minLength: 1,
                select: function (event, ui) {
                    $("#procedureSearch").val(ui.item.label);
                    $("#selectedProcedureId").val(ui.item.id);
                    loadTemplateForProcedure(ui.item.id);
                    return false;
                }
            }).on('input', function () {
                if ($(this).val() === '') {
                    $("#selectedProcedureId").val('');
                    $('#dayEditorContainer').hide();
                }
            });

            // Open Procedure Master in new tab
            $('#btnAddProcedure').click(function () {
                window.open("../master/Proceduremaster", "_blank");
            });

            // Add session row
            $('#addDayRow').click(function () {
                addDayRow(0, 0, '', '', getNextOrder());
            });

            // Remove session row
            $('#dayRows').on('click', '.remove-day', function () {
                $(this).closest('tr').remove();
                renumberRows();
            });

            // Save
            $('#btnSaveEditor').click(function () {
                saveSessionTreatment();
            });

            // Clear
            $('#btnClearEditor').click(function () {
                clearEditor();
            });

            // Success OK button
            $('#successOkBtn').click(function () {
                $('#successModal').fadeOut();
                clearEditor();
            });

            // Default focus
            $('#procedureSearch').focus();
        });

        // Warning popup (same style as registration)
        function warningshow(message, Id) {
            $('#popupmessage').text(message);
            $('#Warningpopup').show();
            if (Id) { $('#' + Id).focus().select(); }
            window.setTimeout(function () {
                $('#Warningpopup').hide();
            }, 3000);
        }

        function fnsessiongenerate() {
            var desiredCount = parseInt($('#txtsessioncount').val());
            if (isNaN(desiredCount) || desiredCount <= 0) {
                warningshow('Please enter a valid number of sessions.', 'txtsessioncount');
                return;
            }
            var procedureId = $('#selectedProcedureId').val();
            if (!procedureId) {
                warningshow('Please select a procedure first.', 'procedureSearch');
                return;
            }
            var currentCount = $('#dayRows .day-row').length;
            if (desiredCount > currentCount) {
                for (var i = 0; i < desiredCount - currentCount; i++) {
                    addDayRow(0, 0, '', '', 0);
                }
                $('#dayEditorContainer').show();
                renumberRows();
            } else if (desiredCount < currentCount) {
                warningshow('You already have ' + currentCount + ' rows. To reduce, please remove rows manually.');
            } else {
                warningshow('You already have ' + currentCount + ' rows. No changes made.');
            }
        }

        function loadTemplateForProcedure(procedureId) {
            console.log("Loading template for procedure:", procedureId);
            $.ajax({
                url: '@Url.Action("GetTemplateByProcedure")',
                type: 'POST',
                data: { procedureId: procedureId },
                success: function (data) {
                    console.log("Template data:", data);
                    $('#dayRows').empty();
                    if (data && data.success === false) {
                        currentTreatmentId = 0;
                        addDayRow(0, 0, '', '', 1);
                        $('#dayEditorContainer').show();
                        return;
                    }
                    if (data && data.error) {
                        warningshow('Error: ' + data.message);
                        return;
                    }
                    if (data && data.type === 2 && data.days) {
                        currentTreatmentId = data.treatmentId || 0;
                        var order = 1;
                        $.each(data.days, function (i, day) {
                            var sessionNumber = day.dayOfWeek || (i + 1);
                            addDayRow(0, sessionNumber, day.duration, day.notes || '', order++);
                        });
                        $('#dayEditorContainer').show();
                    } else {
                        currentTreatmentId = 0;
                        addDayRow(0, 0, '', '', 1);
                        $('#dayEditorContainer').show();
                    }
                },
                error: function (xhr, status, error) {
                    console.error("loadTemplate error:", error, xhr.responseText);
                    warningshow('Error loading template. Check console for details.');
                }
            });
        }

        function addDayRow(dayId, sessionNumber, duration, notes, order) {
            var sessionValue = (sessionNumber > 0) ? sessionNumber : '';
            var row = '<tr class="day-row">' +
                '<td class="slno">' + order + '</td>' +
                '<td>' +
                '<input type="hidden" class="day-id" value="' + dayId + '" />' +
                '<input type="number" class="form-control day-name" placeholder="Session #" value="' + sessionValue + '" />' +
                '</td>' +
                '<td>' +
                '<input type="number" class="form-control day-duration" placeholder="Hours" step="0.5" min="0" value="' + duration + '" />' +
                '</td>' +
                '<td>' +
                '<input type="text" class="form-control day-notes" placeholder="Notes" value="' + notes + '" />' +
                '</td>' +
                '<td>' +
                '<button type="button" class="btn btn-sm btn-danger remove-day">Remove</button>' +
                '</td>' +
                '</tr>';
            $('#dayRows').append(row);
            renumberRows();
        }

        function getSessionNumber(val) {
            var num = parseInt(val);
            return (num > 0) ? num : 0;
        }

        function saveSessionTreatment() {
            console.log("Saving with TreatmentId:", currentTreatmentId);
            var procedureId = $('#selectedProcedureId').val();
            if (!procedureId) {
                warningshow('Please select a procedure.', 'procedureSearch');
                return;
            }

            var formData = {
                TreatmentId: currentTreatmentId,
                ProcedureId: procedureId,
                TreatmentName: $('#procedureSearch').val(),
                TemplateType: 2,
                IsActive: true,
                NumberOfSessions: null,
                DefaultDuration: null,
                Days: []
            };

            var order = 1;
            var valid = true;
            $('#dayRows .day-row').each(function () {
                var sessionVal = $(this).find('.day-name').val();
                var sessionNumber = getSessionNumber(sessionVal);
                var duration = $(this).find('.day-duration').val();
                var notes = $(this).find('.day-notes').val();

                if (sessionNumber === 0 || !duration) {
                    valid = false;
                    return false;
                }

                formData.Days.push({
                    DayId: $(this).find('.day-id').val(),
                    DayOfWeek: sessionNumber,
                    Duration: duration,
                    Notes: notes,
                    DisplayOrder: order++
                });
            });

            if (!valid) {
                warningshow('Please enter valid session numbers and durations.');
                return;
            }

            $('#saveStatus').text('Saving...');
            $.ajax({
                url: '@Url.Action("Create")',
                type: 'POST',
                contentType: 'application/json',
                data: JSON.stringify(formData),
                success: function (res) {
                    console.log("Save response:", res);
                    if (res.success) {
                        $('#saveStatus').text('');
                        if (res.treatmentId && res.treatmentId > 0) {
                            currentTreatmentId = res.treatmentId;
                        }
                        $('#successModal').fadeIn();
                    } else {
                        warningshow(res.message || 'Save failed.');
                        $('#saveStatus').text('');
                    }
                },
                error: function (xhr) {
                    warningshow('Error: ' + xhr.responseText);
                    $('#saveStatus').text('');
                }
            });
        }

        function renumberRows() {
            $('#dayRows .day-row').each(function (index) {
                $(this).find('.slno').text(index + 1);
            });
        }

        function getNextOrder() {
            return $('#dayRows .day-row').length + 1;
        }

        function clearEditor() {
            $('#procedureSearch').val('');
            $('#selectedProcedureId').val('');
            $('#txtsessioncount').val('');
            $('#dayRows').empty();
            $('#dayEditorContainer').hide();
            currentTreatmentId = 0;
            $('#saveStatus').text('');
            $('#procedureSearch').focus();
        }
    </script>
}