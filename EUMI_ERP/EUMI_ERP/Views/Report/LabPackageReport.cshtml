    function MergePackageCells(sel) {
        var prev = null, first = null, span = 0;
        $(sel + ' tbody tr').each(function () {
            var cells = $(this).find('td:nth-child(-n+3)');
            cells.removeAttr('rowspan').css('display', '');          // reset before merging
            var g = $(this).attr('data-g');
            if (g !== undefined && g === prev) {
                cells.css('display', 'none');
                span++;
                first.find('td:nth-child(-n+3)').attr('rowspan', span);
            } else {
                first = $(this); span = 1; prev = (g === undefined ? null : g);
            }
        });
    }


    function ShowSummary(result) {
        disable_datatable('Tblreport', 'buttonPlace');

        var map = {}, order = [];
        for (var i = 0; i < result.length; i++) {
            var r = result[i];
            if (r.Name == 'Total') continue;                 // skip day-wise subtotal rows
            var sp = (r.Department || '').split('##');
            var key = r.PName || '(No Package)';
            if (!map[key]) {
                map[key] = { cnt: 0, cash: 0, upi: 0, credit: 0, net: 0, dis: 0, total: 0, tests: '' };

                order.push(key);
            }
            var m = map[key];
            if (!m.tests) m.tests = r.Tests || '';
            m.cnt++;
            m.cash += parseFloat(sp[0]) || 0;
            m.upi += parseFloat(sp[1]) || 0;
            m.credit += parseFloat(sp[2]) || 0;
            m.net += parseFloat(r.NetAmt) || 0;
            m.dis += parseFloat(r.DiscAmt) || 0;
            m.total += parseFloat(r.TotalAmt) || 0;
        }

        var thead = "<thead><tr>"
            + "<th>Sl#</th><th>Package Name</th><th style='text-align:right;'>Count</th>"
            + "<th style='text-align:right;'>Cash</th><th style='text-align:right;'>UPI</th>"
            + "<th style='text-align:right;'>Credit</th><th style='text-align:right;'>Amount</th>"
            + "<th style='text-align:right;'>Dis</th><th style='text-align:right;'>Total</th>"
            + "</tr></thead>";

        var body = "<tbody>", g = { cnt: 0, cash: 0, upi: 0, credit: 0, net: 0, dis: 0, total: 0 };
        for (var j = 0; j < order.length; j++) {
            var k = order[j], x = map[k];
            body += "<tr><td>" + (j + 1) + "</td><td>" + k + "</td>"
                + "<td align=right>" + x.cnt + "</td>"
                + "<td align=right>" + x.cash.toFixed(Decimal) + "</td>"
                + "<td align=right>" + x.upi.toFixed(Decimal) + "</td>"
                + "<td align=right>" + x.credit.toFixed(Decimal) + "</td>"
                + "<td align=right>" + x.net.toFixed(Decimal) + "</td>"
                + "<td align=right>" + x.dis.toFixed(Decimal) + "</td>"
                + "<td align=right>" + x.total.toFixed(Decimal) + "</td></tr>";
            for (var f in g) g[f] += x[f];
        }
        body += "</tbody>";

        var totalRow = "<tr style='background-color:#d3d3d3;font-weight:bold'><td></td><td>Grand Total</td>"
            + "<td align=right>" + g.cnt + "</td>"
            + "<td align=right>" + g.cash.toFixed(Decimal) + "</td>"
            + "<td align=right>" + g.upi.toFixed(Decimal) + "</td>"
            + "<td align=right>" + g.credit.toFixed(Decimal) + "</td>"
            + "<td align=right>" + g.net.toFixed(Decimal) + "</td>"
            + "<td align=right>" + g.dis.toFixed(Decimal) + "</td>"
            + "<td align=right>" + g.total.toFixed(Decimal) + "</td></tr>";

        $('#Tblreport').html(thead + body + "<tfoot>" + totalRow + "</tfoot>");
        $('#Tblreportprint').html(thead + body.replace("</tbody>", totalRow + "</tbody>"));

        var title = "Lab Package Summary - from " + $("#DateFrom").val() + " to " + $("#DateTo").val();
        var table = $('#Tblreport').DataTable({
            pageLength: 50,
            dom: "<'row'<'col-sm-1'l><'col-sm-11'f>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-1'i><'col-sm-11'p>>",
            buttons: []
        });
        new $.fn.dataTable.Buttons(table, {
            buttons: [{
                extend: 'collection', text: 'Export',
                buttons: [
                    { extend: 'excelHtml5', title: title },
                    { extend: 'pdfHtml5', title: title },
                    { extend: 'print', title: title }
                ]
            }, 'colvis']
        });
        table.buttons(0, null).container().appendTo($("#buttonPlace"));
        $("#buttonPlace").find(".buttons-collection").addClass("btn-outline-primary mx-1").css("border-radius", "4px");

        $('#LabBillLength').val(order.length + 1);   // rows incl. grand total, used by Print
        $('#header').text(title);
    }

    function ShowPaymentHistory(billNo, billYear, patientName) {
        $('#paymentHistoryModal').show();
        $('#paymentHistoryBody').html(
            '<div class="text-center" style="padding:30px;">' +
            '<i class="fa fa-spinner fa-spin fa-2x"></i><br/>Loading...</div>'
        );

        $.ajax({
            type: 'POST',
            url: '../Master/LabBillPaymentHistory',
            data: { BillNo: billNo, BillYear: billYear },
            success: function (result) {
                if (!result.success || !result.billInfo || result.billInfo.length === 0) {
                    $('#paymentHistoryBody').html(
                        '<p class="text-danger text-center">No data found.</p>'
                    );
                    return;
                }

                var bill = result.billInfo[0];
                var payments = result.payments;
                var html = '';

                html += '<div style="background:#f0f9ff; border:1px solid #b3d9f2; border-radius:6px;'
                    + ' padding:12px 15px; margin-bottom:15px; font-size:13px;">';
                html += '<div style="display:flex; flex-wrap:wrap; gap:12px;">';
                html += '<div><strong>Patient:</strong> ' + patientName + '</div>';
                html += '<div><strong>Bill No:</strong> ' + bill.BillNo + '</div>';
                html += '<div><strong>Bill Date:</strong> ' + bill.BillDateTime + '</div>';
                html += '<div><strong>Total Amount:</strong> ₹'
                    + parseFloat(bill.TotalAmt).toFixed(2) + '</div>';
                html += '</div></div>';

                html += '<table class="table table-bordered table-sm" '
                    + 'style="font-size:13px; margin-bottom:8px;">';
                html += '<thead style="background:#00bcd4; color:#fff;">'
                    + '<tr>'
                    + '<th style="width:30px;">#</th>'
                    + '<th>Date / Time</th>'
                    + '<th>Transaction</th>'
                    + '<th style="text-align:right;">Paid</th>'
                    + '<th style="text-align:right;">Balance</th>'
                    + '</tr></thead><tbody>';

                var runningBalance = parseFloat(bill.TotalAmt);
                var rowNum = 1;
                html += '<tr style="background:#fffbe6;">';
                html += '<td>' + rowNum++ + '</td>';
                html += '<td>' + bill.BillDateTime + '</td>';
                html += '<td>Bill Created (Credit)</td>';
                html += '<td style="text-align:right; color:#888;">—</td>';
                html += '<td style="text-align:right; color:red; font-weight:bold;">'
                    + '₹' + parseFloat(runningBalance).toFixed(2) + '</td>';
                html += '</tr>';
                var atBilling = parseFloat(bill.PaidAtBilling);
                if (atBilling > 0) {
                    runningBalance -= atBilling;
                    var modes = [];
                    if (parseFloat(bill.Cash) > 0)
                        modes.push('Cash ₹' + parseFloat(bill.Cash).toFixed(2));
                    if (parseFloat(bill.Upi) > 0)
                        modes.push('UPI ₹' + parseFloat(bill.Upi).toFixed(2));
                    if (parseFloat(bill.Card) > 0)
                        modes.push('Card ₹' + parseFloat(bill.Card).toFixed(2));

                    var balColor = runningBalance <= 0 ? 'green' : 'red';
                    html += '<tr>';
                    html += '<td>' + rowNum++ + '</td>';
                    html += '<td>' + bill.BillDateTime + '</td>';
                    html += '<td>At Billing'
                        + (modes.length > 0 ? ' (' + modes.join(' + ') + ')' : '')
                        + '</td>';
                    html += '<td style="text-align:right; color:green; font-weight:bold;">'
                        + '₹' + atBilling.toFixed(2) + '</td>';
                    html += '<td style="text-align:right; color:' + balColor
                        + '; font-weight:bold;">₹'
                        + parseFloat(runningBalance).toFixed(2) + '</td>';
                    html += '</tr>';
                }
                for (var i = 0; i < payments.length; i++) {
                    var paid = parseFloat(payments[i].PaidAmount);
                    runningBalance -= paid;
                    var bColor = runningBalance <= 0 ? 'green' : 'red';

                    html += '<tr>';
                    html += '<td>' + rowNum++ + '</td>';
                    html += '<td>' + payments[i].PayDate + '</td>';
                    html += '<td>Cash Counter Payment'
                        + (payments[i].ReceivedBy
                            ? ' <span style="color:#888; font-size:11px;">— '
                            + payments[i].ReceivedBy + '</span>'
                            : '')
                        + '</td>';
                    html += '<td style="text-align:right; color:green; font-weight:bold;">'
                        + '₹' + paid.toFixed(2) + '</td>';
                    html += '<td style="text-align:right; color:' + bColor
                        + '; font-weight:bold;">₹'
                        + parseFloat(runningBalance).toFixed(2) + '</td>';
                    html += '</tr>';
                }

                html += '</tbody>';
                var isPaid = runningBalance <= 0;
                var stLabel = isPaid ? 'Paid' : 'Pending';
                var stBg = isPaid ? '#d4edda' : '#fff3cd';
                var stColor = isPaid ? '#155724' : '#856404';

                html += '<tfoot><tr style="background:#f8f9fa; font-weight:bold;">';
                html += '<td colspan="3" style="text-align:right;">Current Balance &amp; Status</td>';
                html += '<td style="text-align:right; font-size:14px;">₹'
                    + parseFloat(runningBalance <= 0 ? 0 : runningBalance).toFixed(2)
                    + '</td>';
                html += '<td style="text-align:center;">'
                    + '<span style="background:' + stBg + '; color:' + stColor
                    + '; padding:3px 12px; border-radius:10px; font-size:12px;">'
                    + stLabel + '</span></td>';
                html += '</tr></tfoot></table>';

                $('#paymentHistoryBody').html(html);
            },
            error: function () {
                $('#paymentHistoryBody').html(
                    '<p class="text-danger text-center">Server error. Please try again.</p>'
                );
            }
        });
    }

    function PrintLabPackage() {
        if (!$('#Tblreportprint').find('tr').length) { alert('Run the report first'); return; }

        var $t = $('#Tblreportprint').clone().removeAttr('id').addClass('rpt');
        $t.find('tr.pk-cont').each(function () {          // Detailed (Test): show Sl#, Reg# and package once per bill
            $(this).children('td').slice(0, 3).html('');
        });
        $t.find('[onclick]').removeAttr('onclick').css('cursor', 'default');

        var title = $('#header').text();

        var logoEl = document.getElementById('ComapnyImage') || ComapnydivToPrint;
        var logoHtml = logoEl ? logoEl.outerHTML : '';
        var companyName = (window.CompanySettingsArray && window.CompanySettingsArray.CompanyName) || '';

        var css = '@@page { size: landscape; margin: 10mm; }'
            + 'body { font-family: Arial, sans-serif; font-size: 11px; }'
            + 'img { max-width: 100%; }'
            + '.hdr { width: 100%; font-size: 85%; border-collapse: collapse; }'
            + '.hdr td { text-align: center; }'
            + '.ttl { width: 100%; height: 50px; margin-top: 10px; margin-bottom: 10px; font-size: 85%; border: 1px solid #000; border-collapse: collapse; }'
            + '.ttl td { text-align: center; }'
            + '.rpt { width: 100%; border-collapse: collapse; }'
            + '.rpt th, .rpt td { border: 1px solid #444; padding: 3px 5px; text-align: left; }'
            + '.rpt th { background: #eee; }'
            + '.rpt td[align=right], .rpt th[style*=right] { text-align: right; }'
            + '.rpt td[align=center] { text-align: center; }'
            + '.paid-badge, .pending-badge { font-weight: bold; }'
            + '.rpt thead { display: table-header-group; } .rpt tr { page-break-inside: avoid; }';

        // Separate popup window (same call style as PrintthisLabBillReport)
        var w = window.open('', '', 'width=1500,height=1500');
        if (!w) { alert('Popup blocked. Please allow popups for this site.'); return; }
        w.document.write('<html><head><title>' + title + '</title><style>' + css + '</style></head><body>'
            + '<table class="hdr"><tr><td>' + logoHtml + '</td></tr>'
            + '<tr><td>' + companyName + '</td></tr></table>'
            + '<table class="ttl"><tr><td>' + title + '</td></tr></table>'
            + $t[0].outerHTML
            + '</body></html>');
        w.document.close();
        w.focus();
        setTimeout(function () { w.print(); }, 300);
    }
</script>






