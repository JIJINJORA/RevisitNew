
@{
    ViewBag.Title = "LabPackageReport";
}


<script type="text/javascript" src="~/ProjectScript/ReportPrint.js"></script>
<script type="text/javascript" src="../Projectscript/Common.js"></script>
<script src="~/Scripts/Autocomplete/jquery-ui.js"></script>

<style>
    .form-control {
        font-weight: bold;
    }

    #btnsubmit:hover {
        -ms-transform: scale(1.1);
        transform: scale(1.1);
    }

    #btnback:hover {
        -ms-transform: scale(1.1);
        transform: scale(1.1);
    }

    #btnprint:hover {
        -ms-transform: scale(1.1);
        transform: scale(1.1);
    }

    .paid-badge {
        background-color: #d4edda;
        color: #155724;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: bold;
        white-space: nowrap;
    }

    .pending-badge {
        background-color: #fff3cd;
        color: #856404;
        padding: 2px 8px;
        border-radius: 10px;
        font-size: 11px;
        font-weight: bold;
        white-space: nowrap;
    }
    #Tblreport tr.pk-first td {
        border-top: 2px solid #9fd8e0;
    }

    #Tblreport tr.pk-cont td {
        font-size: 13px;
    }
    #Tblreport td.tn {
        white-space: nowrap;
    }

    #Tblreport tr.pk-first td {
        border-top: 2px solid #9fd8e0;
    }

    #Tblreport tr.pk-cont td {
        font-size: 13px;
    }
    #Tblreport td.mg {
        vertical-align: middle;
        text-align: center;
        background: #fff;
    }

    #Tblreport.table-striped tbody tr.pg-odd {
        background-color: #f4f6f6;
    }

    #Tblreport.table-striped tbody tr.pg-even {
        background-color: #fff;
    }

    #Tblreport.table-hover tbody tr:hover {
        background-color: #bdf4fa;
    }
</style>

<div class="myData" data-x="" />
<div id="Entry">

    <div class="row">
        <div class="col-md-12">
            <div class="card">
                <div class="card-header" style="border-bottom:1px solid #e6e6e6">
                    <div>


                        <table width="100%">
                            <tr>
                                <td><h4 id="header"></h4></td>
                                <td>
                                    <div class="custom-control custom-radio" style="display:inline-block; margin-right:15px;">
                                        <input type="radio" class="custom-control-input" name="rptView" id="rptSummary" checked>
                                        <label class="custom-control-label" for="rptSummary" style="font-weight:bold">Summary</label>
                                    </div>
                                    <div class="custom-control custom-radio" style="display:inline-block; margin-right:15px;">
                                        <input type="radio" class="custom-control-input" name="rptView" id="rptDetailedTest">
                                        <label class="custom-control-label" for="rptDetailedTest" style="font-weight:bold">Detailed (Test)</label>
                                    </div>
                                    <div class="custom-control custom-radio" style="display:inline-block;">
                                        <input type="radio" class="custom-control-input" name="rptView" id="rptDetailed">
                                        <label class="custom-control-label" for="rptDetailed" style="font-weight:bold">Detailed</label>
                                    </div>
                                    <div class="custom-control custom-radio" style="display:inline-block; margin-left:15px;">
                                        <input type="radio" class="custom-control-input" name="rptView" id="rptPackageList">
                                        <label class="custom-control-label" for="rptPackageList" style="font-weight:bold">Package List</label>
                                    </div>
                                </td>
                                <td align="right"><button type="button" style="width:100px" onclick="$('#popupdiv').show(), $('#User').focus()" id="btnback" class="btn btn-outline-primary">Back</button></td>
                                <td><button type="button" style="width:100px;margin-left:20px" id="btnprint" onclick="PrintLabPackage()" class="btn btn-primary">Print <i class="ft-printer"></i></button></td>

                                <td align="right">

                                    <div class="btn-group" id="buttonPlace">

                                        <div align="right">
                                            <div class="heading-elements">
                                                <div class="btn-group" id="buttonPlace">

                                                </div>
                                            </div>
                                        </div>

                                    </div>
                                </td>

                            </tr>
                        </table>


                        <div align="right">

                            <div class="heading-elements">

                                <div id="divreport" style="display:none; overflow:auto">
                                    <hr style="margin-top:.1%;" />

                                    <table id="Tblreport" class="table table-striped table-bordered dataTable" style="width:100%;margin: 0 auto 0 0;"></table><br />
                                </div>
                                <div style="display:none">
                                    <table id="Tblreportprint"></table>
                                </div>

                            </div>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    </div>
</div>


<div id="popupdiv" class="modal fade text-left show" tabindex="-1" role="dialog" aria-labelledby="myheader" style="padding-right: 17px; background:rgba(0,0,0,0.5); display: block; display:none1">
    <div class="modal-dialog" role="document" style="top:10%">
        <div class="modal-content">
            <div class="modal-header bg-primary white">
                <h3 class="modal-title" id="myheader">Lab Package Report</h3>
                <button type="button" class="close" onclick="popuprefresh()" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">×</span>
                </button>
            </div>
            <form id="monthpopup" style="display:none1">
                <div class="modal-body">
                    <div class="row">
                        <label style="font-weight:bold;margin-left:11%">From</label>
                        <div class="col-md-4">
                            <input type="text" id="DateFrom" class="form-control" autocomplete="off">
                        </div>


                        <label style="font-weight:bold;margin-left:4%">To</label>
                        <div class="col-md-4">
                            <input type="text" id="DateTo" class="form-control" autocomplete="off">
                        </div>
                    </div>
                    <div style="display:flex;align-items:center;margin:3% 6% 0 6%">
                        <label style="width:120px;margin:0;font-weight:bold">Patient</label>
                        <input type="text" id="PatientName" class="form-control" style="flex:1" placeholder="Type patient name / reg no" autocomplete="off" />
                        <input type="hidden" id="PatientRegNo" value="0" />
                    </div>

                    <div style="display:flex;align-items:center;margin:3% 6% 0 6%">
                        <label style="width:120px;margin:0;font-weight:bold">Group</label>
                        <select id="Hospital" class="form-control" style="flex:1"></select>
                    </div>

                    <div style="display:flex;align-items:center;margin:3% 6% 0 6%">
                        <label style="width:120px;margin:0;font-weight:bold">Package Name</label>
                        <select id="PackageId" class="form-control" style="flex:1"></select>
                    </div>

                    <div style="display:flex;align-items:center;margin:3% 6% 0 6%">
                        <label style="width:120px;margin:0;font-weight:bold">User</label>
                        <select id="UserId" class="form-control" style="flex:1"></select>
                    </div>




                </div>

                <div class="modal-footer">


                    <table width="100%">
                        <tr>
                            <td align="left">
                                <div class="custom-control custom-checkbox" style="display:inline-block; margin-right:15px;">
                                    <input type="checkbox" class="custom-control-input" name="customCheck" id="grpbyall" autocomplete="off">
                                    <label class="custom-control-label" for="grpbyall" style="font-weight:bold">Day Wise</label>
                                </div>
                                
                            </td>
                            <td align="right">
                                <button type="button" style="width:100px;margin-right:6%" id="btnsubmit" class="btn btn-primary">Go</button>
                                <input type="hidden" id="LabBillLength" class="form-control" />
                            </td>
                        </tr>
                    </table>
                    @*<button type="button" style="width:100px;margin-right:6%" id="btnsubmit" class="btn btn-primary">Go</button>
                        <input type="hidden" id="LabBillLength" class="form-control" />*@
                </div>
            </form>

        </div>
    </div>
</div>
<div id="paymentHistoryModal" style="display:none; position:fixed; top:0; left:0; width:100%; height:100%; background:rgba(0,0,0,0.5); z-index:9999; overflow-y:auto;">
    <div style="background:#fff; width:650px; margin:60px auto; border-radius:8px; box-shadow:0 4px 20px rgba(0,0,0,0.3);">
        <div style="background:#00bcd4; color:#fff; padding:15px 20px; border-radius:8px 8px 0 0; display:flex; justify-content:space-between; align-items:center;">
            <h5 style="margin:0; font-size:16px;">
                <i class="ft-credit-card"></i> Payment History
            </h5>
            <span onclick="$('#paymentHistoryModal').hide()" style="cursor:pointer; font-size:20px; font-weight:bold;">&times;</span>
        </div>
        <div id="paymentHistoryBody" style="padding:20px;">
            <div class="text-center"><i class="fa fa-spinner fa-spin"></i> Loading...</div>
        </div>
    </div>
</div>
<script>

    UserList();
    PackageLoad();
    LoadPatientSearch();

    function PackageLoad() {
        $.ajax({
            type: "POST",
            url: "../Master/CostCenterGetandGets",
            data: { CostCenterId: 0 },
            success: function (result) {
                $("#PackageId").empty().append("<option value='0'>ALL</option>");
                var list = result.oList || [];
                for (var i = 0; i < list.length; i++) {
                    $("#PackageId").append("<option value='" + list[i].CostCenterId + "'>" + list[i].CostCenterName + "</option>");
                }
            }
        });
    }
    function RunReport() {
        var mode = $("#rptPackageList").prop("checked") ? "list"
            : ($("#rptDetailedTest").prop("checked") ? "test"
                : ($("#rptDetailed").prop("checked") ? "detail" : "summary"));
        var DFlag = (mode === "list") ? 2
            : ((mode === "detail" && $("#grpbyall").prop("checked")) ? 1 : 0);   // Day Wise only for plain Detailed

        $('#Loading').show();

        var data = {};
        data.FromDate = $('#DateFrom').val() + '##' + DFlag;
        data.ToDate = $('#DateTo').val() + '##' + ($('#PackageId').val() || 0);
        data.RegNo = parseInt($('#PatientRegNo').val() || 0);
        data.UserId = parseInt($('#UserId').val() || 0);

        $.ajax({
            type: "POST",
            url: "../Master/LabPackageReport",
            data: data,
            success: function (result) {
                $('#Loading').hide();
                $('#divreport').show();
                $('#popupdiv').hide();
                if (mode === "list") ShowPackageList(result);
                else if (mode === "test") Showreport(result, true, true);
                else if (mode === "detail") Showreport(result, true, false);
                else ShowSummary(result);
            }
        });
    }
    function LoadPatientSearch() {
        $("#PatientName").autocomplete({
            delay: 0,
            minLength: 1,
            source: function (request, response) {
                $('#PatientRegNo').val(0);           // typing again clears the previous pick
                $.ajax({
                    url: '../Revisit/HMS_IPorPatientSearch',
                    type: "POST",
                    data: { PatientName: $("#PatientName").val(), DeptId: ERPDeptId },
                    dataType: "json",
                    success: function (data) {
                        response($.map(data, function (item) {
                            return {
                                ColCount: '2',
                                label: item.PatientName,
                                label1: item.OPSerName + ' - ' + item.OPNumber,
                                OPNumber: item.OPNumber,
                                PatientName: item.PatientName,
                                headers: ["Patient", "RegNo"]
                            };
                        }));
                    }
                });
            },
            autoFocus: true,
            select: function (event, ui) {
                $('#PatientRegNo').val(ui.item.OPNumber);
                $('#PatientName').val(ui.item.PatientName);
                return false;
            }
        }).on('input', function () {
            if ($(this).val() == '') $('#PatientRegNo').val(0);   // emptied box means ALL patients
        });
    }
    function popuprefresh() {
        $('#popupdiv').hide();
    }


    function UserList() {

        var data = {};
        data.UserId = 0;
        $.ajax({
            type: "POST",
            url: "../Master/UsersGetandGets",
            data: data,
            success: function (result) {
                ShowUserslist(result.oList);
            }
        });

    }



    var data = {};
    data.HospitalId = 0;
    $.ajax({
        type: "POST",
        url: "../Master/HospitalGetandGets",
        data: data,
        success: function (result) {
            ShowTermlist(result.oList);
        }
    });

    function ShowTermlist(result) {
        //console.log(result)
        $("#Hospital").html('')

        $("#Hospital").append("<option value=0>ALL</option>");
        for (var i = 0; i < result.length; i++) {
            $("#Hospital").append("<option value=" + result[i].HospitalId + ">" + result[i].HospitalName + "</option>");
        }
    }


    function ShowUserslist(result) {
        $("#UserId").append("<option value='0'>All</option>");
        for (var i = 0; i < result.length; i++) {

            $("#UserId").append("<option value='" + result[i].UserId + "'>" + result[i].UserName + "</option>");

        }

    }

    function TestsText(t) {
        if (!t) return '';
        var a = t.split('|'), n = [];
        for (var i = 0; i < a.length; i++) n.push(a[i].split('~')[0]);
        return n.join(', ');            // use n.join('<br>') for one test per line
    }
    function ToggleListFilters() {
        var isList = $('#rptPackageList').prop('checked');
        $('#PatientName, #UserId, #grpbyall').prop('disabled', isList);
        if (isList) { $('#PatientName').val(''); $('#PatientRegNo').val(0); $('#UserId').val('0'); }
    }

    function ShowPackageList(result) {
        disable_datatable('Tblreport', 'buttonPlace');

        var f2 = function (v) { return (parseFloat(v) || 0).toFixed(Decimal); };

        // inline styles on purpose: the Print window does not load this page's CSS
        var S_HEAD = 'display:flex;justify-content:space-between;gap:12px;padding-bottom:3px;margin-bottom:2px;border-bottom:1px solid #888;color:#555;font-size:12px;';
        var S_ROW = 'display:flex;justify-content:space-between;gap:12px;padding:2px 0;border-bottom:1px dashed #bbb;';
        var S_TOT = 'display:flex;justify-content:space-between;gap:12px;padding-top:4px;margin-top:3px;border-top:1px solid #444;font-weight:bold;';

        var thead = "<thead><tr>"
            + "<th style='width:5%'>Sl#</th>"
            + "<th style='width:20%'>Package Name</th>"
            + "<th style='width:55%'>Tests Included</th>"
            + "<th style='width:20%;text-align:right;'>Package Price</th>"
            + "</tr></thead>";

        var body = "<tbody>", n = 0;
        for (var i = 0; i < result.length; i++) {
            var r = result[i];
            if (r.Name == 'Total') continue;
            n++;

            var testsHtml = '<div class="pl-head" style="' + S_HEAD + '"><span>Test</span><span>Rate</span></div>';
            var sum = 0;
            var a = (r.Tests || '').split('|');
            for (var k = 0; k < a.length; k++) {
                if (!a[k]) continue;
                var p = a[k].split('~');
                var rate = (p.length > 1) ? (parseFloat(p[1]) || 0) : 0;
                sum += rate;
                testsHtml += '<div class="pl-row" style="' + S_ROW + '"><span>' + p[0] + '</span><span>' + f2(rate) + '</span></div>';
            }
            testsHtml += '<div class="pl-tot" style="' + S_TOT + '"><span>Total of tests</span><span>' + f2(sum) + '</span></div>';

            body += "<tr><td>" + n + "</td>"
                + "<td><b>" + (r.PName || '') + "</b></td>"
                + "<td>" + testsHtml + "</td>"
                + "<td align=right><b>" + f2(r.TotalAmt) + "</b></td></tr>";
        }
        body += "</tbody>";

        $('#Tblreport').html(thead + body);
        $('#Tblreportprint').html(thead + body);

        var title = "Lab Package List";

        // Excel / PDF: flatten the test block to "Test - Rate" lines (print button keeps the layout)
        var exportOpts = {
            stripHtml: false,
            format: {
                body: function (data, row, col) {
                    var $d = $('<div>').html(data);
                    if (col !== 2) return $d.text();
                    var out = [];
                    $d.find('.pl-row').each(function () {
                        var s = $(this).children('span');
                        out.push($(s[0]).text() + ' - ' + $(s[1]).text());
                    });
                    var t = $d.find('.pl-tot span');
                    if (t.length > 1) out.push('Total of tests: ' + $(t[1]).text());
                    return out.join('\n');
                }
            }
        };

        var table = $('#Tblreport').DataTable({
            pageLength: 50,
            dom: "<'row'<'col-sm-1'l><'col-sm-11'f>>" +
                "<'row'<'col-sm-12'tr>>" +
                "<'row'<'col-sm-1'i><'col-sm-11'p>>",
            buttons: []
        });
        new $.fn.dataTable.Buttons(table, {
            buttons: [{
                extend: 'collection', text: 'Export',
                buttons: [
                    { extend: 'excelHtml5', title: title, exportOptions: exportOpts },
                    { extend: 'pdfHtml5', title: title, exportOptions: exportOpts },
                    { extend: 'print', title: title }
                ]
            }, 'colvis']
        });
        table.buttons(0, null).container().appendTo($("#buttonPlace"));
        $("#buttonPlace").find(".buttons-collection").addClass("btn-outline-primary mx-1").css("border-radius", "4px");

        $('#LabBillLength').val(n);
        $('#header').text(title);
    }

    function DoctorLoad() {
        var data = {};                                       //dropdownbind
        data.DoctorId = 0;
        data.DeptId = ERPDeptId;
        $.ajax({
            type: "POST",
            url: "../Revisit/HMS_RevistDoctorGets",
            data: data,
            success: function (result) {
                if (result.oList.length > 0) {
                    $("#Doctor").empty();
                    $("#Doctor").append("<option value='0' Fee='0'>Select</option>");
                    for (var i = 0; i < result.oList.length; i++) {
                        $("#Doctor").append("<option value='" + result.oList[i].DoctorId + "' Fee='" + result.oList[i].ConsultFees + "'>" + result.oList[i].DoctorName + "</option>");
                    }
                }
            }
        });
    }

    function RepCell(first, v) {
        return first ? v : '<span style="display:none">' + v + '</span>';
    }

    function Showreport(result, isDetailed, showTests) {
        disable_datatable('Tblreport', 'buttonPlace');

        var responseText = "<thead><tr>"
            + "<th align=center>Sl#</th>"
            + "<th>Reg#</th>"
            + "<th>Package Name</th>"
            + (showTests ? "<th>Test Name</th>" : "")
            + "<th>Date</th>"
            + "<th>Time</th>"
            + "<th>Patient</th>"
            + "<th>Doctor</th>"
            + "<th>BNo#</th>"
            + "<th>Cash</th>"
            + "<th>UPI</th>"
            + "<th>Credit</th>"
            + "<th style='text-align:right;'>Amount</th>";

        if (isDetailed) {
            responseText += "<th style='text-align:right;'>Balance</th>"
                + "<th style='text-align:center;'>Status</th>";
        }

        responseText += "<th style='text-align:right;'>Dis</th>"
            + "<th style='text-align:right;'>Total</th>"
            + "</tr></thead><tbody>";

        var f2 = function (v) { return parseFloat(v).toFixed(Decimal); };
        var bills = 0, rows = 0;

        for (var i = 0; i < result.length; i++) {
            var r = result[i];
            var spstring = (r.Department || '').split("##");

            if (r.Name == 'Total') {
                rows++;
                responseText += '<tr style=background-color:#d3d3d3>'
                    + '<td></td><td></td><td></td>' + (showTests ? '<td></td>' : '')
                    + '<td>' + r.BillDate + '</td>'
                    + '<td></td>'
                    + '<td><b>' + r.Name + '</b></td>'
                    + '<td>' + r.Hospital + '</td>'
                    + '<td>' + r.BillNo + '</td>'
                    + '<td align=right>' + spstring[0] + '</td>'
                    + '<td align=right>' + spstring[1] + '</td>'
                    + '<td align=right>' + spstring[2] + '</td>'
                    + '<td align=right><b>' + f2(r.NetAmt) + '</b></td>';

                if (isDetailed) {
                    responseText += '<td align=right><b>' + f2(r.BalanceAmount) + '</b></td><td></td>';
                }

                responseText += '<td align=right><b>' + f2(r.DiscAmt) + '</b></td>'
                    + '<td align=right><b>' + f2(r.TotalAmt) + '</b></td>'
                    + '</tr>';
                continue;
            }

            bills++;
            var tests = (showTests && r.Tests) ? r.Tests.split('|') : [''];
            var statusClass = (r.PaymentStatus === 'Paid') ? 'paid-badge' : 'pending-badge';
            var balanceColor = (r.PaymentStatus === 'Paid') ? '' : 'color:red;';

            for (var t = 0; t < tests.length; t++) {
                var first = (t === 0);
                var testName = tests[t].split('~')[0];
                var rowCls = showTests ? ((first ? 'pk-first' : 'pk-cont') + (bills % 2 ? ' pg-odd' : ' pg-even')) : '';
                var mg = showTests ? ' class="mg"' : '';
                rows++;

                responseText += '<tr class="' + rowCls + '" data-g="' + i + '">'
                    + '<td' + (showTests ? ' class="mg"' : ' align=center') + '>' + bills + '</td>'
                    + '<td' + mg + '>' + r.RegNo + '</td>'
                    + '<td' + mg + '>' + (showTests ? '<b>' + (r.PName || '') + '</b>' : (r.PName || '')) + '</td>'
                    + (showTests ? '<td class="tn">' + testName + '</td>' : '')
                    + '<td>' + RepCell(first, r.BillDate) + '</td>'
                    + '<td>' + RepCell(first, spstring[3] || '') + '</td>'
                    + '<td>' + RepCell(first, r.Name) + '</td>'
                    + '<td>' + RepCell(first, r.Hospital) + '</td>'
                    + '<td>' + RepCell(first, r.BillNo) + '</td>'
                    + '<td align=right>' + (first ? spstring[0] : '-') + '</td>'
                    + '<td align=right>' + (first ? spstring[1] : '-') + '</td>'
                    + '<td align=right>' + (first ? spstring[2] : '-') + '</td>'
                    + '<td align=right>' + (first ? f2(r.NetAmt) : '-') + '</td>';

                if (isDetailed) {
                    responseText += '<td align=right style="' + balanceColor + '">' + (first ? f2(r.BalanceAmount) : '-') + '</td>'
                        + '<td align=center>'
                        + (first
                            ? '<span class="' + statusClass + '" style="cursor:pointer;" '
                            + 'onclick="ShowPaymentHistory(' + r.BillNo + ',' + new Date().getFullYear() + ',\'' + r.Name + '\')">'
                            + r.PaymentStatus + '</span>'
                            : '')
                        + '</td>';
                }

                responseText += '<td align=right>' + (first ? f2(r.DiscAmt) : '-') + '</td>'
                    + '<td align=right>' + (first ? f2(r.TotalAmt) : '-') + '</td>'
                    + '</tr>';
            }
        }

        var tfootHtml = '<tfoot><tr>'
            + '<th></th><th></th><th></th>' + (showTests ? '<th></th>' : '') + '<th></th><th></th>'
            + '<th>Patient</th><th>Doctor</th>'
            + '<th></th><th></th><th></th><th></th><th></th>';

        if (isDetailed) {
            tfootHtml += '<th></th><th></th>';
        }

        tfootHtml += '<th></th><th></th></tr></tfoot>';

        $('#Tblreport').html(responseText + '</tbody>' + tfootHtml);
        $('#Tblreportprint').html(responseText + '</tbody>');

        var title = "Lab Package Report - from " + $("#DateFrom").val() + " to " + $("#DateTo").val();
        datatableWithsearch2('Tblreport', true, title, 'buttonPlace', isDetailed, showTests);
        $('#LabBillLength').val(rows);
        $('#header').text(title);
    }

    function datatableWithsearch2(tablename, download, title, tableButtonContainerId, isDetailed, showTests) {

        var a = '#' + tablename + ' tfoot th'
        $(a).each(function () {
            var title = $(this).text();
            if (title != ' ')
                $(this).html('<input type="text" placeholder="Search ' + title + '" style="width:100%" />');

        });
        var table = null;
        if (download) {

            if (!title || !tableButtonContainerId) { console.log("download table need title and button container"); }

            var colDefs = showTests ? [
                { "width": "3%", "targets": 0 },
                { "width": "5%", "targets": 1 },
                { "width": "8%", "targets": 2 },
                { "width": "24%", "targets": 3 },
                { "width": "7%", "targets": 4 },
                { "width": "6%", "targets": 5 },
                { "width": "12%", "targets": 6 },
                { "width": "9%", "targets": 7 }
            ] : [];

            table = $('#' + tablename).DataTable({
                "pageLength": 50,
                "ordering": !showTests,
                "order": [],
                "drawCallback": function () { if (showTests) MergePackageCells('#' + tablename); },
                dom: "<'row'<'col-sm-1'l><'col-sm-11'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-1'i><'col-sm-11'p>>",
                buttons: [],
                "columnDefs": colDefs
            });

            var allCols = table.columns().indexes().toArray();
            new $.fn.dataTable.Buttons(table, {
                buttons: [
                    {
                        extend: 'collection',
                        text: 'Export',
                        buttons: [
                            { extend: 'excelHtml5', title: title, messageTop: '', exportOptions: { columns: allCols } },
                            { extend: 'pdfHtml5', title: title, messageTop: '', exportOptions: { columns: allCols } },
                            { extend: 'print', title: title, messageTop: '', exportOptions: { columns: allCols } }
                        ]
                    },
                    'colvis'
                ]
            });

            table.buttons(0, null).container().appendTo($("#" + tableButtonContainerId));
            $("#" + tableButtonContainerId).find(".buttons-collection").addClass("btn-outline-primary mx-1").css("border-radius", "4px");
        }
        else {
            table = $('#' + tablename).DataTable();
        }
        table.columns().every(function () {
            var that = this;
            $('input', this.footer()).on('keyup change', function () {
                if (that.search() !== this.value) {
                    that
                        .search(this.value)
                        .draw();

                }
            });
        });
    }

