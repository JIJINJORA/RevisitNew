@{
    ViewBag.Title = "TATimeReport";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<style>
    .label-control {
        font-weight: bold;
    }

    .bgcolor {
        background-color: #daeff1;
    }

    #divContainerNew {
        border: solid 1px black;
        min-width: 200px;
        min-height: 40px;
        width: auto;
        height: auto;
        background-color: white;
        cursor: pointer !important;
        font-weight: bold;
    }

    .divpop {
        position: absolute;
        text-align: left;
        display: none;
        color: black;
        border-radius: 3px;
    }

    .pointer:hover {
        background-color: #acd6f5;
        text-decoration: underline;
    }

    /* TA Exceeded - Red */
    #tbl_WorkSheet tbody tr.ta-exceeded td {
        background-color: #ffcccc !important;
    }

    #tbl_WorkSheet tbody tr.ta-exceeded:hover td,
    #tbl_WorkSheet tbody tr.ta-exceeded.odd td,
    #tbl_WorkSheet tbody tr.ta-exceeded.even td {
        background-color: #ffaaaa !important;
    }

    /* TA Within Time - Green */
    #tbl_WorkSheet tbody tr.ta-ok td {
        background-color: #ccffcc !important;
    }

    #tbl_WorkSheet tbody tr.ta-ok:hover td,
    #tbl_WorkSheet tbody tr.ta-ok.odd td,
    #tbl_WorkSheet tbody tr.ta-ok.even td {
        background-color: #aaffaa !important;
    }
</style>


<script src="~/Scripts/Autocomplete/jquery-ui.js"></script>
<div class="myData" data-x="" />

<div id="listing">
    <section>
        <div class="row">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <table width="100%" style="table-layout:fixed;" class="bgcolor">
                            <tr>
                                <td>
                                    <h4 id="header" class="card-title pt-2 pb-2" style="font-weight:bold;">TA Time Report</h4>
                                </td>
                                <td>
                                    <!-- TA Summary Bar -->
                                    <div id="taSummaryBar" style="display:none;">
                                        <div style="display:inline-flex; align-items:center; gap:14px;
                                                    background:#f4f4f4; border:1px solid #ccc; border-radius:6px;
                                                    padding:5px 14px; font-size:13px; font-weight:600;">
                                            <span id="sumCases" style="color:#333;">case(s): 0</span>
                                            <span style="color:#aaa;">|</span>
                                            <span id="sumDone" style="color:#28a745;">&#9654; Done: 0</span>
                                            <span id="sumPending" style="color:#e67e00;">&#9654; Pending: 0</span>
                                            <span style="color:#aaa;">|</span>
                                            <span id="sumExceeded" style="color:#cc0000;">&#9650; Exceeded: 0</span>
                                            <span id="sumOnTime" style="color:#007a00;">&#10003; On Time: 0</span>
                                        </div>
                                    </div>
                                    <!-- End TA Summary Bar -->
                                </td>
                                <td align="right">
                                    <div class="heading-elements">
                                        <div>
                                            <span id="itemListButtonPlace"></span>
                                        </div>
                                    </div>
                                </td>
                            </tr>
                        </table>
                        <table width="100%" class="bgcolor">
                            <tr>
                                <td>
                                    <label class="label-control">Date :</label>
                                </td>
                                <td width="150px;">
                                    <input type="text" id="FromDate" class="form-control dedate" />
                                </td>
                                <td>
                                    <label class="label-control pl-2 pr-1">-</label>
                                </td>
                                <td width="150px;">
                                    <input type="text" id="ToDate" class="form-control dedate" />
                                </td>
                                <td>
                                    <label class="label-control pl-1">Doctor :</label>
                                </td>
                                <td>
                                    <input type="text" id="Doctor" class="form-control denull" />
                                    <input type="hidden" id="DoctorId" class="form-control dezro" value="0" />
                                </td>
                                <td>
                                    <label class="label-control pl-1">Reg# :</label>
                                </td>
                                <td width="10%">
                                    <input type="text" id="RegNo" class="form-control denull" />
                                    <input type="hidden" id="PatientId" class="form-control dezro" value="0" />
                                </td>
                                <td align="left">
                                    <button type="button" id="btnsearch" class="btn btn-outline-primary mt-2 ml-1">
                                        Search <i class="fa fa-search"></i>
                                    </button>
                                    <button id="btnrefresh" type="button" class="btn btn-outline-info mt-2">
                                        <i class="ft-refresh-cw"></i>
                                    </button>
                                </td>
                                <td align="right">
                                    <button type="button" class="btn btn-outline-success mt-2" onclick="GoPage('Revisit/LabBill');">New Lab Bill</button>
                                </td>
                            </tr>
                        </table>
                    </div>
                    <div class="card-content collapse show" oncontextmenu="return false">
                        <div class="card-body card-dashboard" style="overflow:auto">
                            <table width="100%" id="tbl_WorkSheet" class="table table-striped table-bordered base-style dataTable"></table>
                            <br />
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </section>
</div>

<div id="divContainerNew" class="row divpop" onmouseleave="$('#divContainerNew').slideUp()" oncontextmenu="return false">
    <div class="pointer pl-1 pt-1" id="Context_1" onclick="RedirectTo('1')">Lab Bill</div>
    <div class="pointer pl-1 pt-1" id="Context_2" onclick="RedirectTo('2')">Test Result</div>
    <div class="pointer pl-1 pt-1" id="Context_3" onclick="RedirectTo('3')">Procedure Bill</div>
    <div class="pointer pl-1 pt-1" id="Context_4" onclick="RedirectTo('4')">Reg Bill Copy</div>
    <div style="display:none">
        <input type="text" id="CurrentselectedId" class="form-control dezro" value="0" />
    </div>
</div>

<div id="CaseSheetPopUpMsg" style="display:none;">
    <div class="toast-container toast-top-center">
        <div class="toast-deep-orange" aria-live="assertive" style="opacity:1">
            <div class="toast-message row" style="font-weight:400;font-size:large;">
                <div id="PopUpMsg" class="col-md-10 p-0" onclick="PopUpMsg()">
                    No Case Sheet Found
                </div>
                <div class="col-md-2 p-0" onclick="$('#CaseSheetPopUpMsg').fadeOut('slow')">
                    <i class="fa fa-close"></i>
                </div>
            </div>
        </div>
    </div>
</div>


<script>
    var colorArray = ['#33ccff', '#ff66cc', '#ff9966', '#FFFF99', '#00B3E6',
        '#E6B333', '#3366E6', '#999966', '#99FF99', '#B34D4D'];

    $(function () {
        document.title = "TA Time Report";

        $('#FromDate,#ToDate').daterangepicker({
            minDate: minDate,
            maxDate: new Date(new Date().getFullYear() + 1, new Date().getMonth(), new Date().getDate()),
            singleDatePicker: true,
            showDropdowns: true,
            locale: {
                format: 'DD/MM/YYYY'
            }
        });
        $('.dedate').val(CurDate);

        GetList(CurDate, CurDate, 0, 0);

        $("#btnsearch").click(function (e) {
            GetList($('#FromDate').val(), $('#ToDate').val(), $("#DoctorId").val(), $("#PatientId").val());
        });

        $("#btnrefresh").click(function (e) {
            $('.dedate').val(CurDate);
            $('.denull').val('');
            $('.dezro').val(0);

            GetList(CurDate, CurDate, 0, 0);
        });

        $("#tbl_WorkSheet").on('touchstart mousedown', function (e) {
            if (e.button == 2) {
                var o = {
                    left: e.pageX,
                    top: e.pageY
                };
                $("#divContainerNew").offset(o);
            }
        });

        $("#btnsearch").focus(function (e) {
            $("#btnsearch").removeClass("btn btn-outline-primary");
            $("#btnsearch").addClass("btn btn-primary");
        });

        $("#btnsearch").focusout(function (e) {
            $("#btnsearch").removeClass("btn btn-outline-primary");
            $("#btnsearch").addClass("btn btn-outline-primary");
        });
    });

    $("#RegNo").autocomplete({
        delay: 0,
        minLength: 0,
        source: function (request, response) {
            $("#PatientId").val(0);
            var data = {};
            data.PatientName = $("#RegNo").val();
            data.DeptId = ERPDeptId;

            $.ajax({
                url: '../Revisit/HMS_PatientSearch',
                type: "POST",
                data: data,
                dataType: "json",
                success: function (data) {
                    response($.map(data, function (item) {
                        return ({
                            ColCount: '2',
                            label: item.OPSerName + '-' + item.OPNumber,
                            label1: item.PatientName,
                            PatientId: item.PatientId,
                            DOB: item.DOB,
                            Contact: item.Contact,
                            OPNumber: item.OPNumber,
                            PatientName: item.PatientName,
                            headers: ["RegNo", "Patient"]
                        })
                    }));
                }
            })
        },
        autoFocus: true,
        select: function (event, ui) {
            $("#PatientId").val(ui.item.OPNumber);
            $("#btnsearch").focus();
        },
    });

    // ---------- Doctor autocomplete  ----------
    $("#Doctor").autocomplete({
        delay: 0,
        minLength: 0,
        source: function (request, response) {
            $("#DoctorId").val(0);
            var data = {};
            data.DoctorName = $("#Doctor").val();
            data.DeptId = ERPDeptId;

            $.ajax({
                url: '../Revisit/HMS_WorkSheetDoctorSearch',
                type: "POST",
                data: data,
                dataType: "json",
                success: function (data) {
                    response($.map(data, function (item) {
                        return ({
                            ColCount: '2',
                            label: item.DoctorName,
                            label1: item.Status,
                            DoctorId: item.DoctorId,
                            headers: ["Doctor", "Department"]
                        })
                    }));
                }
            })
        },
        autoFocus: true,
        select: function (event, ui) {
            $("#DoctorId").val(ui.item.DoctorId);
            $("#btnsearch").focus();
        },
    });

    function GetList(FromDate, ToDate, Doctor, Patient) {
        $('#LoadingSmall').show();
        var data = {};
        data.FromDate = FromDate;
        data.ToDate = ToDate;
        data.DoctorId = Doctor;
        data.PatientId = Patient;
        data.DeptId = ERPDeptId;
        data.UserId = ERPUserId;
        $.ajax({
            type: "POST",
            url: "../Master/RPT_TATimeReport",
            data: data,
            success: function (result) {
                LoadList(result);
            }
        });
    }

    function LoadList(result) {
        disable_datatable('tbl_WorkSheet', 'itemListButtonPlace');
        var responseText = "<thead><tr>" +
            "<th style='align=center'>Sl#</th>" +
            "<th>Reg#</th>" +
            "<th>Date</th>" +
            "<th>Bill Time</th>" +
            "<th>Patient</th>" +
            "<th>Age/Sex</th>" +
            "<th>Contact</th>" +
            "<th>Bill No</th>" +
            "<th>Test Name</th>" +
            "<th>Sample Taken</th>" +
            "<th>Result Time</th>" +
            "<th>TA Time</th>" +
            "<th>Status</th>" +
            "</tr></thead><tbody>";

        // --- Summary counters ---
        var uniqueBills = {};
        var cntDone = 0, cntPending = 0, cntExceeded = 0, cntOnTime = 0;

        for (var i = 0; i < result.length; i++) {

            // Summary counts
            uniqueBills[result[i].BillNo] = true;
            if (result[i].Status == 'PENDING') cntPending++;
            else cntDone++;
            if (result[i].Type == 1) cntExceeded++;
            else if (result[i].Type == 2) cntOnTime++;

            if (result[i].Status == 'PENDING') var Status = '<span class="badge badge-warning white">PENDING</span>';
            else var Status = '<span class="badge badge-success">RESULT</span>';

            var trClass = '';
            if (result[i].Type == 1) {
                trClass = 'ta-exceeded';
            } else if (result[i].Type == 2) {
                trClass = 'ta-ok';
            }

            var ageSex = (result[i].Remarks || '').split("##")[0] + '/' +
                (result[i].Gender == 1 ? 'M' : result[i].Gender == 2 ? 'F' : 'O');

            var slno = parseInt(i + 1);
            responseText += '<tr class="' + trClass + '" onmousedown="WhichButton(event,' + slno + ')" oncontextmenu="return false">' +
                '<td align=center>' + slno +
                '<input type="hidden" id="OPVisitId_' + slno + '" value="' + result[i].OpNo + '" />' +
                '<input type="hidden" id="OPSerName_' + slno + '" value="' + result[i].RegSeries + '" />' +
                '<input type="hidden" id="OPNumber_' + slno + '" value="' + result[i].RegNo + '" />' +
                '<input type="hidden" id="PatientId_' + slno + '" value="' + result[i].PatientId + '" />' +
                '<input type="hidden" id="DOB_' + slno + '" value="' + result[i].AdmitTime + '" />' +
                '<input type="hidden" id="BloodGroup_' + slno + '" value="' + (result[i].Remarks || '') + '" />' +
                '<input type="hidden" id="PatientName_' + slno + '" value="' + result[i].Name + '" />' +
                '<input type="hidden" id="Gender_' + slno + '" value="' + result[i].Gender + '" />' +
                '<input type="hidden" id="IPNumber_' + slno + '" value="' + result[i].IpNo + '" />' +
                '</td>' +
                '<td>' + result[i].SeriesPrefix + '-' + result[i].RegNo + '</td>' +
                '<td id="RevisitDate_' + slno + '">' + result[i].BillDate + '</td>' +
                '<td>' + result[i].AdmitTime + '</td>' +
                '<td>' + result[i].Name + '</td>' +
                '<td>' + ageSex + '</td>' +
                '<td>' + result[i].Cashrec + '</td>' +
                '<td align=center style="color:black;font-weight:bold">' + result[i].BillNo + '</td>' +
                '<td>' + (result[i].TestName || '') + '</td>' +
                '<td align=center>' + (result[i].SampleCollectionTime || '') + '</td>' +
                '<td align=center>' + (result[i].ResultTime || '') + '</td>' +
                '<td align=center>' + (result[i].StdTATime || '') + '</td>' +
                '<td align=center>' + Status + '</td>' +
                '</tr>';
        }

        // --- Update Summary Bar ---
        var totalCases = Object.keys(uniqueBills).length;
        $('#sumCases').text('case(s): ' + totalCases);
        $('#sumDone').html('&#9654; Done: ' + cntDone);
        $('#sumPending').html('&#9654; Pending: ' + cntPending);
        $('#sumExceeded').html('&#9650; Exceeded: ' + cntExceeded);
        $('#sumOnTime').html('&#10003; On Time: ' + cntOnTime);
        $('#taSummaryBar').show();
        // --- End Summary Bar ---

        $('#tbl_WorkSheet').html(responseText + "</tbody><tfoot><tr>" +
            "<th> </th>" +
            "<th>Reg#</th>" +
            "<th> </th>" +
            "<th> </th>" +
            "<th>Patient</th>" +
            "<th> </th>" +
            "<th>Contact</th>" +
            "<th> </th>" +
            "<th>Test Name</th>" +
            "<th> </th>" +
            "<th> </th>" +
            "<th> </th>" +
            "<th> </th>" +
            "</tr></tfoot>");

        var title = 'TA Time Report   from ' + $("#FromDate").val() + ' To ' + $("#ToDate").val();
        datatableWithsearch('tbl_WorkSheet', true, title, 'itemListButtonPlace');
        $('#header').text(title);
        $('#LoadingSmall').hide();
    }

    function WhichButton(e, Id) {
        if (e.button == 2) {
            $("#divContainerNew").slideDown(500);
            $("#CurrentselectedId").val(Id);
        }
    }

    function RedirectTo(Flag) {
        if ($("#CurrentselectedId").val() != 0) {
            var Id = $("#CurrentselectedId").val();

            if (Flag == 1) {
                sessionStorage.setItem("BSOP_PI", $("#PatientId_" + Id).val());
                sessionStorage.setItem("BSOP_IP", $("#IPNumber_" + Id).val());
                window.open('../Revisit/LabBill?from=SOPWorkSheet', '_blank');
            }
            else if (Flag == 2) {
                sessionStorage.setItem("SOP_OV", $("#OPVisitId_" + Id).val());
                sessionStorage.setItem("SOP_RS", $("#OPSerName_" + Id).val());
                sessionStorage.setItem("SOP_RN", $("#OPNumber_" + Id).val());
                sessionStorage.setItem("SOP_PI", $("#PatientId_" + Id).val());
                sessionStorage.setItem("SOP_DO", $("#DOB_" + Id).val());
                sessionStorage.setItem("SOP_BG", $("#BloodGroup_" + Id).val());
                sessionStorage.setItem("SOP_PN", $("#PatientName_" + Id).val());
                sessionStorage.setItem("SOP_GE", $("#Gender_" + Id).val());
                sessionStorage.setItem("SOP_IP", $("#IPNumber_" + Id).val());
                window.open('../Revisit/LabResult?from=SOPWorkSheet', '_blank');
            }
            else if (Flag == 3) {   //Procedure Bill
            }
            else if (Flag == 4) {   //Reg Bill Copy
            }
        }
    }

    function datatableWithsearch(tablename, download, title, tableButtonContainerId) {
        var a = '#' + tablename + ' tfoot th';
        $(a).each(function () {
            var title = $(this).text();
            if (title != ' ')
                $(this).html('<input type="text" placeholder="Search ' + title + '" style="width:100%" />');
        });

        var table = null;
        if (download) {
            if (!title || !tableButtonContainerId) { console.log("download table need title and button container"); }

            table = $('#' + tablename).DataTable({
                dom: "<'row'<'col-sm-1'l><'col-sm-11'f>>" +
                    "<'row'<'col-sm-12'tr>>" +
                    "<'row'<'col-sm-1'i><'col-sm-11'p>>",
                buttons: [],

                "columnDefs": [
                    { "width": "1%", "targets": 0 },
                    { "width": "4%", "targets": 1 },
                    { "width": "4%", "targets": 2 },
                    { "width": "3%", "targets": 3 },
                    { "width": "12%", "targets": 4 },
                    { "width": "3%", "targets": 5 },
                    { "width": "5%", "targets": 6 },
                    { "width": "3%", "targets": 7 },
                    { "width": "14%", "targets": 8 },
                    { "width": "5%", "targets": 9 },
                    { "width": "5%", "targets": 10 },
                    { "width": "4%", "targets": 11 },
                    { "width": "4%", "targets": 12 },
                ],
            });

            new $.fn.dataTable.Buttons(table, {
                buttons: [
                    {
                        extend: 'collection',
                        text: 'Export',
                        className: 'excelexport',
                        buttons: [
                            {
                                extend: 'excelHtml5',
                                title: title,
                                messageTop: 'MEDOC HMS',
                                exportOptions: { columns: ":visible" }
                            },
                            {
                                extend: 'pdfHtml5',
                                title: title,
                                messageTop: 'MEDOC HMS',
                                orientation: 'landscape',
                                pageSize: 'A4',
                                exportOptions: { columns: ":visible" },
                                customize: function (doc) {
                                    doc.defaultStyle.fontSize = 8;
                                    doc.styles.tableHeader.fontSize = 8;

                                    var tableNode = null;
                                    for (var i = 0; i < doc.content.length; i++) {
                                        if (doc.content[i] && doc.content[i].table) {
                                            tableNode = doc.content[i].table;
                                            break;
                                        }
                                    }

                                    if (tableNode) {
                                        var colCount = tableNode.body[0].length;
                                        tableNode.widths = Array(colCount).fill('*');
                                    }

                                    doc.pageMargins = [20, 30, 20, 20];
                                }
                            },
                            {
                                extend: 'print',
                                title: title,
                                messageTop: 'MEDOC HMS',
                                exportOptions: { columns: ":visible" }
                            }
                        ]
                    },
                    'colvis'
                ]
            });

            table.buttons(0, null).container().appendTo($("#" + tableButtonContainerId));
            $("#" + tableButtonContainerId).find(".buttons-collection").addClass("btn-outline-primary mx-1").css("border-radius", "4px");
        }
        else {
            table = $('#' + tablename).DataTable({});
        }

        table.columns().every(function () {
            var that = this;
            $('input', this.footer()).on('keyup change', function () {
                if (that.search() !== this.value) {
                    that.search(this.value).draw();
                }
            });
        });

        if (ExcelExport == 0) {
            $('.excelexport').hide();
        }
    }

    function disable_datatable(tablename, tableButtonContainerId) {
        $('#Warningpopup').fadeOut();
        if ($.fn.DataTable.isDataTable('#' + tablename)) {
            var table = $('#' + tablename).DataTable();
            table.destroy();
            if (tableButtonContainerId) { $("#" + tableButtonContainerId).empty(); }
            return;
        }
    }

    function isNumber(evt, selectedvalue) {
        var charCode = (evt.which) ? evt.which : event.keyCode;
        $(selectedvalue).val($(selectedvalue).val().replace(/[^0-9\.]/g, ''));
        if (charCode != 8 && (charCode != 46 || $(selectedvalue).val().indexOf('.') != -1) && charCode != 13 && (charCode < 48 || charCode > 57)) {
            evt.preventDefault();
            warningshow('Digits Only');
            return false;
        }
        return true;
    }
</script>