        function generateSlots(durationMinutes) {
            const slots = [];
            const START_MINUTE = 8 * 60;
            const END_MINUTE = 20 * 60;
            for (let currentMinute = START_MINUTE; currentMinute < END_MINUTE; currentMinute += durationMinutes) {
                const hour = Math.floor(currentMinute / 60);
                const minute = currentMinute % 60;
                const ampm = hour >= 12 ? 'PM' : 'AM';
                const displayHour = hour % 12 === 0 ? 12 : hour % 12;
                const timeString = `${displayHour}:${minute.toString().padStart(2, '0')} ${ampm}`;
                let group = hour < 13 ? 'morning' : (hour < 17 ? 'afternoon' : 'evening');
                slots.push({ time: timeString, group: group });
            }
            return slots;
        }

