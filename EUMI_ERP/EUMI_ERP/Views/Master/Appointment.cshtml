            }

            const allSlots = generateSlots(slotDurationMinutes);
            const groups = { morning: [], afternoon: [], evening: [] };
            allSlots.forEach(s => groups[s.group] && groups[s.group].push(s.time));

            ['morning', 'afternoon', 'evening'].forEach(key => {
                if (groups[key].length === 0) return;

                let html = `<div class="mb-4"><h3 class="text-lg font-semibold text-gray-800 mt-4 mb-3 capitalize">${key} Slots</h3><div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">`;

                groups[key].forEach(time => {

                    debugger;
                    const isBooked = bookedTimes.includes(time);
                    let className = 'time-slot bg-white text-gray-700 hover:bg-gray-50 hover:border-gray-300 cursor-pointer';
                    let tooltip = "";
                    let disabledAttr = "";

                    if (selectedTime === time) {
                        className = 'time-slot selected-slot cursor-pointer';
                    } else if (isBooked) {
                        className = 'booked-slot custom-tooltip-container cursor-not-allowed';
                        tooltip = '(Booked)';
                        disabledAttr = "disabled";
                    }

                    if (isBooked) {
                        html += `<button class="${className} text-sm font-medium py-3 rounded-xl border shadow-none flex items-center justify-center gap-1" ${disabledAttr}>${time} <i class="fas fa-lock text-xs opacity-50"></i></button>`;
                    } else {
                        html += `<button class="${className} text-sm font-medium py-3 rounded-xl border shadow-soft transition" data-time="${time}">${time}</button>`;
                    }
                });
                html += `</div></div>`;
                container.innerHTML += html;
            });

            // Re-attach listeners
            document.querySelectorAll('.time-slot:not(:disabled)').forEach(btn => {
                btn.onclick = (e) => {
                    // ... copy existing handler logic if simpler, or call a named function
                    document.querySelectorAll('.time-slot').forEach(b => {
                        b.classList.remove('selected-slot');
                        b.classList.add('bg-white', 'text-gray-700');
                    });
                    e.currentTarget.classList.add('selected-slot');
                    e.currentTarget.classList.remove('bg-white', 'text-gray-700');
                    selectedTime = e.currentTarget.dataset.time;

                    // NEW FLOW: Open modal immediately for 'New' entry
                    $('#AppointmentId').val(0);
                    $('#patient-slot-info').text("New Appointment");
                    $('#saveBtn').html('<i class="fas fa-save mr-2"></i> Save Booking');
                    showPatientModal();
                }
            });
        }

        function generateDays() {
            const dayPicker = document.getElementById('dayPicker');
            dayPicker.innerHTML = '';
            document.getElementById('currentMonthDisplay').textContent = currentMonth.toLocaleDateString('en-US', { year: 'numeric', month: 'long' });

            const currentDoctor = MOCK_DOCTORS.find(d => d.id === selectedDoctor);
            const doctorAvailableDays = currentDoctor ? currentDoctor.availableDays : [];
            const displayStartDate = new Date(currentMonth.getFullYear(), currentMonth.getMonth(), 1);
            if (currentMonth.getMonth() === today.getMonth()) displayStartDate.setDate(today.getDate());

            const nextMonth = new Date(currentMonth.getFullYear(), currentMonth.getMonth() + 1, 1);
            const displayEndDate = new Date(nextMonth.getFullYear(), nextMonth.getMonth() + 1, 0);

            let currentDate = new Date(displayStartDate);
            while (currentDate <= displayEndDate) {
                const dateValue = formatDate(currentDate);
                const dayIndex = currentDate.getDay();
                const isDisabled = !doctorAvailableDays.includes(dayIndex);

                const btn = document.createElement('button');
                btn.className = `day-slot flex-shrink-0 w-20 h-24 flex flex-col justify-center items-center p-3 rounded-xl shadow-soft border transition duration-150 ease-in-out ${isDisabled ? 'bg-gray-100 text-gray-400 cursor-not-allowed opacity-50' : 'bg-white text-gray-700 hover:bg-gray-50'}`;
                btn.dataset.date = dateValue;
                if (isDisabled) btn.disabled = true;
                else btn.addEventListener('click', handleDayClick);

                btn.innerHTML = `<span class="text-base font-medium mb-1">${shortDaysOfWeek[dayIndex]}</span><span class="text-2xl font-bold">${currentDate.getDate()}</span>`;
                dayPicker.appendChild(btn);
                currentDate.setDate(currentDate.getDate() + 1);
            }
        }

        function renderTimeSlots11111() {
            const container = document.getElementById('timeSlotsContainer');
            container.innerHTML = '';

            if (!selectedDay) {
                container.innerHTML = `<p class="text-gray-500">Please select an available date.</p>`;
                return;
            }

            const allSlots = generateSlots(slotDurationMinutes);
            const groups = { morning: [], afternoon: [], evening: [] };
            allSlots.forEach(s => groups[s.group] && groups[s.group].push(s.time));

            ['morning', 'afternoon', 'evening'].forEach(key => {
                if (groups[key].length === 0) return;
                // Updated grid to support 6 columns on large screens
                let html = `<h3 class="text-lg font-semibold text-gray-800 mt-4 mb-3 capitalize">${key} Slots</h3><div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 lg:grid-cols-6 gap-3">`;
                groups[key].forEach(time => {
                    // Match against doctor ID as well for accuracy
                    debugger;
                    const booked = isSlotBooked(selectedDoctor, selectedDay, time);
                    let className = booked
                        ? 'booked-slot custom-tooltip-container'
                        : (time === selectedTime ? 'selected-slot' : 'time-slot bg-white text-gray-700 hover:bg-gray-50 border-gray-300');

                    let tooltip = '';
                    if (booked) {
                        tooltip = `
                                                            <div class="custom-tooltip">
                                                                <p class="font-bold border-b border-gray-500 pb-1 mb-1">Booked</p>
                                                                <p class="text-xs">Name: ${booked.FirstName}</p>
                                                                <p class="text-xs">Phone: ${booked.Contact}</p>
                                                            </div>
                                                        `;
                    }

                    html += `<button class="${className} text-sm font-medium py-3 rounded-xl border shadow-soft transition" data-time="${time}">${time} ${tooltip}</button>`;
                });
                html += `</div>`;
                container.innerHTML += html;
            });

            document.querySelectorAll('.time-slot').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    document.querySelectorAll('.time-slot').forEach(b => {
                        b.classList.remove('selected-slot');
                        b.classList.add('bg-white', 'text-gray-700');
                    });
                    e.currentTarget.classList.add('selected-slot');
                    e.currentTarget.classList.remove('bg-white', 'text-gray-700');
                    selectedTime = e.currentTarget.dataset.time;

                    // NEW FLOW: Open modal immediately for 'New' entry
                    $('#AppointmentId').val(0);
                    $('#patient-slot-info').text("New Appointment");
                    $('#saveBtn').html('<i class="fas fa-save mr-2"></i> Save Booking');
                    showPatientModal();
                });
            });
        }

        // Modal Control
        function showPatientModal() {
            const doctor = MOCK_DOCTORS.find(d => d.id == selectedDoctor);
            const doctorSelect = document.getElementById('Doctor');

            // Only populate doctor dropdown if we are in 'New' mode (ID=0),
            // otherwise ShowTermGet handles it
            if ($('#AppointmentId').val() == "0") {
                document.getElementById('patient-form').reset();
                document.getElementById('patient-form').reset();
                document.getElementById('PDATE').value = formatDateToDisplay(selectedDay);
                document.getElementById('PTime').value = selectedTime;

                if (doctorSelect && doctor) {
                    doctorSelect.innerHTML = `<option value="${doctor.id}">${doctor.name}</option>`;
                    doctorSelect.value = doctor.id;
                }

                if (doctor) {
                    $('#patient-slot-info').text(`${doctor.name} - ${selectedDay} at ${selectedTime}`);
                }
            } else {
                // Editing mode: Ensure the select has options if not already populated
                if (doctorSelect && doctorSelect.options.length === 0) {
                    // Populate all doctors for edit mode availability
                    MOCK_DOCTORS.forEach(d => {
                        const opt = document.createElement('option');
                        opt.value = d.id;
                        opt.text = d.name;
                        doctorSelect.appendChild(opt);
                    });
                }
            }

            document.body.style.overflow = 'hidden';
            const modal = document.getElementById('patient-modal');
            modal.classList.remove('hidden');
            setTimeout(() => {
                document.getElementById('patient-modal-content').classList.remove('scale-95', 'opacity-0');
                document.getElementById('patient-modal-content').classList.add('scale-100', 'opacity-100');
                // Default focus on First Name field
                document.getElementById('AppFirst').focus();
            }, 10);
        }

        window.closePatientModal = function () {
            document.body.style.overflow = '';
            document.getElementById('patient-modal-content').classList.remove('scale-100', 'opacity-100');
            document.getElementById('patient-modal-content').classList.add('scale-95', 'opacity-0');
            selectedTime = null;

            // FIX: Do NOT call renderTimeSlots() here. It defaults to empty list and unblocks everything.
            // Instead, just un-highlight the currently selected slot visually.
            document.querySelectorAll('.selected-slot').forEach(el => {
                el.classList.remove('selected-slot');
                el.classList.add('bg-white', 'text-gray-700');
            });

            setTimeout(() => document.getElementById('patient-modal').classList.add('hidden'), 300);
        }

        // --- Search Modal Functions ---
        window.openSearchModal = function () {
            // Populate Doctor Search dropdown if empty
            const doctorSearchSelect = document.getElementById('DoctorSearchId');
            if (doctorSearchSelect && doctorSearchSelect.options.length <= 1) {
                MOCK_DOCTORS.forEach(d => {
                    const opt = document.createElement('option');
                    opt.value = d.id;
                    opt.text = d.name.toUpperCase() + ' - ' + d.specialty.toUpperCase();
                    doctorSearchSelect.appendChild(opt);
                });
            }

            // Set default dates to Today (dd/mm/yyyy)
            const today = new Date();
            const yyyy = today.getFullYear();
            const mm = String(today.getMonth() + 1).padStart(2, '0');
            const dd = String(today.getDate()).padStart(2, '0');
            const todayStr = `${dd}/${mm}/${yyyy}`; // dd/mm/yyyy format

            const fromEl = document.getElementById('FromDate');
            const toEl = document.getElementById('ToDate');
            fromEl.value = todayStr;
            toEl.value = todayStr;

            document.body.style.overflow = 'hidden';
            const modal = document.getElementById('search-modal');
            modal.classList.remove('hidden');
        }

        window.closeSearchModal = function () {
            document.body.style.overflow = '';
            document.getElementById('search-modal').classList.add('hidden');
        }

        window.AppointmentSearchList = function () {
            var data = {};
            data.FromDate = $("#FromDate").val();
            data.ToDate = $("#ToDate").val();
            data.Doctor = $("#DoctorSearchId").val();

            $.ajax({
                type: "POST",
                url: "../Master/AppointmentSearchList",
                data: data,
                success: function (result) {
                    ShowSearchlist(result.oList);
                },
                error: function (err) {
                    console.warn("Backend search failed, using local mock data");
                    // Fallback: Filter local bookings for demo
                    let mockResults = bookings;
                    if (data.Doctor && data.Doctor != '0') {
                        mockResults = mockResults.filter(b => b.DoctorId == data.Doctor);
                    }
                    ShowSearchlist(mockResults);
                }
            });
        }

        window.ShowSearchlist = function (result) {
            closeSearchModal(); // Adapted from $('#popupdiv').hide()
            $('#calendar-view').hide(); // Adapted from $('#Entry').hide()
            $('#listing').show();
            disable_datatable('tblAppointment');

            var Editbutton = '<button class="text-blue-600 hover:text-blue-800 transition"><i class="fas fa-edit"></i></button>';
            var responseText = "<thead><tr><th width=1%;align=center>Sl#</th><th width=4% >RegId</th><th  width=20%>Name</th><th  width=10%>MR #</th><th width=15% class='text-left' >Doctor</th><th width=15%>Date</th><th width=10%>Time</th><th width=10% class='text-left' >Mobile No:</th><th width=3%>Edit</th></tr></thead><tbody>";

            for (var i = 0; i < result.length; i++) {
                var slno = parseInt(i + 1);
                // Ensure properties exist/fallback
                var id = result[i].AppointmentId;
                var fname = result[i].FirstName || '';
                var lname = result[i].LastName || '';
                var doc = result[i].Doctor || ('Doctor ' + result[i].DoctorId) || '';
                var date = result[i].AppointmentDate || '';
                var time = result[i].AppointmentTime || '';
                var contact = result[i].Contact || '';

                responseText += '<tr><td align=center>' + slno + '</td><td>' + id + '</td><td>' + fname + '</td><td>' + lname + '</td><td align=left>' + doc + '</td><td align=left>' + date + '</td><td align=left>' + time + '</td><td align=left>' + contact + '</td><td onclick="GetRows(' + id + ')" align=center width=10px bgcolor="#00ffff "><a>' + Editbutton + '</a></td></tr>';
            }
            $('#tblAppointment').html(responseText + '</tbody> <tfoot> <tr><th> </th><th>Code</th><th>Name</th><th> </th><th> </th></tr></tfoot>');
            datatableWithsearch1('tblAppointment');
        }

        window.onload = function () {
            Doctorload();
            document.getElementById('scrollLeftBtnDoctor').onclick = () => document.getElementById('doctorSelection').scrollBy({ left: -200, behavior: 'smooth' });
            document.getElementById('scrollRightBtnDoctor').onclick = () => document.getElementById('doctorSelection').scrollBy({ left: 200, behavior: 'smooth' });
            document.getElementById('scrollLeftBtn').onclick = () => { currentMonth.setMonth(currentMonth.getMonth() - 1); generateDays(); };
            document.getElementById('scrollRightBtn').onclick = () => { currentMonth.setMonth(currentMonth.getMonth() + 1); generateDays(); };
        };
    </script>
</body>

